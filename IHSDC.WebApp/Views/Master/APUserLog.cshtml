@model IHSDC.WebApp.Models.APUserLog
@using IHSDC.WebApp.Models;
@using Microsoft.AspNet.Identity
@using IHSDC.WebApp.Helper
@using IHSDC.WebApp.Connection
@{
    ViewBag.Title = "AP Logs";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}
<style id="table_style" type="text/css">
    @@media print {

        @@page {
            size: A3 landscape;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        body::after {
            content: none !important;
        }

        .card-page {
            break-after: page;
        }

            .card-page:last-of-type {
                break-after: auto;
            }

        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 10px;
            background-color: gray;
            color: white;
            text-align: center;
            padding: 10px;
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 10px;
            background-color: gray;
            color: white;
            text-align: center;
            padding: 10px;
        }
    }
    .custom-watermark {
        transform: rotate(-45deg);
        z-index: 10000;
        opacity: 0.3;
        color: #8e9191;
        position: fixed;
        left: 6%;
        top: 39%;
        font-size: 80px;
        font-weight: 500;
        display: grid;
        justify-content: center;
        align-content: center;
    }
    .custom-card-body {
        box-shadow: -1px 2px 16px 3px;
        padding: 0.5rem;
    }
    .custom-text-center {
        text-align: center;
    }
    .custom-hidden {
        display: none;
    }
    .custom-table-spacing {
        margin-left: 1rem;
        padding-right: 2rem;
    }
    .custom-modal-dialog {
        margin-top: 130px;
        width: 440mm;
        max-width: 100%;
        box-shadow: 8px 8px 20px rgba(0, 0, 0, 0.5);
    }
    .custom-paragraph {
        margin-left: 10px;
        margin-right: 10px;
        font-size: 15px;
        font-family: Arial, sans-serif;
    }
    .custom-modal-body {
        max-height: 600px;
        overflow: auto;
    }
   
</style>
<div class="card-body custom-card-body" id="lowzoom">
    <div class="row">
        <div class="col">
            <h3 class="custom-text-center">
                AP Logs
                <a class="btn btn-info float-right" href="@Url.Action("Index","Home")" target="_top">
                    Back
                </a>
            </h3>

        </div>
    </div>
    @using (Html.BeginForm("APUserLog", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
       <div class="rcorners custom-hidden">
           <div class="row">
               <div class="col-2">
                   <p class="mb-0">From Date</p>
                   @Html.TextBoxFor(m => m.LogFromDate, new { @class = "form-control datepicker3", @placeholder = "dd/mm/yyyy", @autocomplete = "off", @required = true })
               </div>

               <div class="col-2">
                   <p class="mb-0">To Date</p>
                   @Html.TextBoxFor(m => m.LogToDate, new { @class = "form-control datepicker3", @placeholder = "dd/mm/yyyy", @autocomplete = "off", @required = true })
               </div>

           </div>
       </div>
        <span id="spnAviator"></span>
        <div class="row">
            <div class="table-responsive custom-table-spacing">
                <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-info text-white">
                        <tr>
                            <th class="center">Ser No</th>
                            <th class="center">User Name</th>
                            <th class="center">Full Name</th>
                            <th class="center">Unit</th>
                            <th class="center">Role</th>
                            <th class="rcorners custom-hidden">ID</th>
                            <th class="rcorners custom-hidden">Role</th>

                            @if (SessionManager.RoleId == enum1.Administrator)
                            {
                                <th class="center">Switch User</th>

                            }


                        </tr>
                    </thead>
                    <tbody id="tbody">
                        @if (ViewBag.count > 0)
                        {

                            foreach (var item in Model.IAPUserLog)
                            {
                                <tr>
                                    <td>
                                        @{ sno++; }
                                        @sno
                                    </td>

                                    <td>@Html.DisplayFor(modelItem => item.UserName)</td>

                                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>

                                    <td>@Html.DisplayFor(modelItem => item.UnitName)</td>

                                    <td>@Html.DisplayFor(modelItem => item.RoleName)</td>

                                    <td class="rcorners custom-hidden"><spam class="Aviator_ID">@Html.DisplayFor(modelItem => item.IntId)</spam></td>
                                    <td class="rcorners custom-hidden"><spam class="User_Name">@Html.DisplayFor(modelItem => item.UserName)</spam></td>

                                    @if (SessionManager.RoleId == enum1.Administrator)
                                    {

                                        <td>

                                            <button type="button" id="BtnUserLog" class="btn btn-success BtnUserLog">
                                                <i class='far fa-user-circle'></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {

                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
</div>
<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>

<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<link href="~/NewContent/SearchDate/dataTables.dataTables.css" rel="stylesheet" />
<script src="~/NewContent/SearchDate/jquery-3.7.1.js"></script>
<script src="~/NewContent/SearchDate/moment.min.js"></script>
<div class="modal fade" id="APUserLog">
    <div class="modal-dialog custom-modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-center">
                <p class="custom-paragraph">
                    <span>User Name :&nbsp;&nbsp;&nbsp;&nbsp;</span><b><span id="SpnAviatorName"></span></b><br />
                </p>
                <button type="button" class="btn btn-danger CloseLogpoup" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body custom-modal-body" id="UserLogPrint">
                <h3 class="text-center">Switch user</h3>

                <div class="table-responsive">
                    <table class="table table-striped" id="aviatorTable" width="100%" cellspacing="0">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="APUserLogDiv">
    <div class="modal-dialog custom-modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-center">
                <p class="custom-paragraph">
                    <span>User Name :&nbsp;&nbsp;&nbsp;&nbsp;</span><b><span id="SpnAviatorNameDiv"></span></b><br />
                </p>
                <button type="button" class="btn btn-danger CloseLogpoup" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body custom-modal-body" id="UserLogPrintDiv">
                <h3 class="text-center">Agenda Pt Log</h3>

                <div class="table-responsive">
                    <table class="table table-striped" id="aviatorTbl" width="100%" cellspacing="0">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
<form id="myForm" class="form-horizontal" role="form" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="userName" name="userName" />
    <input type="hidden" id="ReturnUrl" name="ReturnUrl" />
</form>

<script>
    $(document).ready(function () {
        $('.BtnUserLog').click(function () {
            
            var row = $(this).closest('tr');
            var aviatorId = row.find('.Aviator_ID').text();
            var userName = row.find('.User_Name').text();


            $('#ReturnUrl').val('APLOG^' + userName);

            
          $.ajax({
            url: '@Url.Action("clientIp", "Master")',
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                if (response === 1) {
                    $.ajax({
                        url: '@Url.Action("Login", "Account")',
                        type: 'POST',
                        data: $('#myForm').serialize(),
                        success: function(response) {
                            if (response == 1) {
                                window.location.href = '@Url.Action("AddInboxNotingFwd", "ACC")';
                            }
                        },
                        error: function(xhr, status, error) {
                            alert('Error: ' + error);
                        }
                    });
                    return true;
                } else {
                    alert("Error. Please Contact System Admin");
                    return false;
                }
            },
            error: function(xhr, status, error) {
                alert('Error:', error);
            }
        });
        });
    });
</script>


<script type="text/javascript">
        $('.CloseLogpoup').on('click', function (e) {
            var modal = document.getElementById("APUserLog");
            modal.style.display = "none";
        });




        $(document).ready(function () {
            $('#dataTable').DataTable({
                paging: true, 
                info: true, 
                "lengthMenu": [5, 10, 25, 50], 
                "pageLength": 5 
            });
        });

    function PrintDiv() {
        var divToPrint = document.getElementById('APUserLog');
        var popupWin = window.open('', '_blank', 'top=100,width=900,height=500,location=no');
        popupWin.document.open();
        var table_style = document.getElementById("table_style").innerHTML;
        popupWin.document.write('<style type = "text/css">');
        popupWin.document.write(table_style);
        popupWin.document.write('</style>')
        popupWin.document.title = 'MonthWiseUsersLog';
        popupWin.document.write('<html><body onload="window.print()">' + divToPrint.innerHTML + '<div class="custom-watermark">' + '@(ViewBag.ipadd)' + "" + '</html>');
        popupWin.document.close();
    }

</script>


