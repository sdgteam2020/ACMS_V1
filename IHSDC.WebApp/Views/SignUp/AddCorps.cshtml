<div class="card-body" style="padding: 0.3rem; border: 0px solid #89CFF0; width: 600px;">
    @using (Html.BeginForm("AddCorps", "SignUp", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="col">
            <div class="row" style="margin-left:1rem;">
                <div class="col-md-12">
                    <label><b>Comd/PSOs Name</b></label><font style="color:red; font-weight:bold; font-size:20px;">*</font>
                    @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select Comd --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @maxlength = "20" })
                  
                </div>
            </div>

            <div class="row" style="margin-left:1rem;">
                <div class="col-md-12">
                    <label><b>DGs Name</b></label><font style="color:red; font-weight:bold; font-size:20px;">*</font>
                    @Html.TextBoxFor(m => m.CorpsName, new { @class = "form-control", @maxlength = "25", @onkeyup = "ValInData(this)" })

                  

                </div>
                <div class="col-md-12 text-right">
                    <button type="button" style="margin-top: 2.5rem;" value="@ViewBag.ButtonName" id="btnval" onclick="AddConfirmationDgs(this,'/SignUp/AddCorps','AddCorps',event)" name="btnval" class="btn btn-success">@ViewBag.ButtonName</button>
                </div>
            </div>

        </div>
        
        <div class="dropdown-divider"></div>


        <div class="table-responsive" style=" margin-left: 1rem; padding-right: 2rem;">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>


                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILCorpsCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>

                            </tr>
                        }
                    }
                    else
                    {

                    }
                </tbody>
            </table>
        </div>
    }
</div>


<script src="~/Scripts/jquery-3.3.1.js"></script>
