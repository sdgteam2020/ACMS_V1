@model System.Web.Mvc.FormCollection
@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml";
}


<!DOCTYPE html>
<html>

<head>
    <style>
      

        body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .container {
            height: 100vh;
            width: 100vw;
            
        }

        .center {
            display: block;
            margin: 0 auto;
            margin-left: auto;
            margin-right: auto;
            width: 12%;
        }

        a {
            color: white !important;
        }
        .custom-card {
            height: 65% !important;
            box-shadow: 1px 1px 9px 2px !important;
            background-color: #46bdf4;
        }
        .custom-align-center {
            align-content: center;
        }
        .custom-profile-img {
            height: 8rem;
            width: 9rem;
            border-radius: 50%;
        }
        .custom-time {
            float: right;
            font-weight: bold;
            color: white !important;
        }
        .custom-heading {
            font-family: Arial, sans-serif;
            color: white;
            text-align: center;
            font-size: 24px;
        }
        .custom-strong {
            color: white;
        }
        #textContainer {
            /* Replace with your desired color */
            display: inline;
        }
    </style>
    <script>
        window.addEventListener("keydown", function (e) {
            if (e.key === "ArrowUp" || e.key === "ArrowDown") {
                e.preventDefault();
            }
        });

        window.addEventListener("wheel", function (e) {

            e.preventDefault();
        });
    </script>
</head>

<body>
    <div class="container card border-left-primary shadow h-100 py-2 custom-card">
        <div class="row">
            <div class="col-md-12 custom-align-center">

                <img src="~/Images/er2.jpg" class="center custom-profile-img">
                <strong class="custom-time">
                    Time&nbsp;&nbsp;&nbsp; - &nbsp;&nbsp;&nbsp;
                    @ViewBag.CurrentTime.ToString("dd-MM-yyyy HH:mm:ss")
                    &nbsp;&nbsp;&nbsp;
                </strong>
            </div>
        </div>
        <div class="row1">

            <div class="col-md-12">
                <h1 class="custom-heading">
                    <strong>
                        Unauthorized Operation!!
                    </strong>
                </h1>
            </div>

            <div class="col-md-12">
                <h1 class="custom-heading">

                    <strong class="custom-strong">
                        <u>Request pl contact Administrator for further assistance</u>
                    </strong>
                </h1>
            </div>
           
        </div>

      
       
    </div>

 
    <br />
    <br />

</body>

</html>
