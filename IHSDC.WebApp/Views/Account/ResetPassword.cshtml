@model IHSDC.WebApp.Models.ForgotPasswordViewModel


@{
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

    int sno = 0;
    ViewBag.Title = "Reset password";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml";
}

<div class="card-body">
    <div class="table-responsive">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th class="center">S/No</th>
                    <th class="center">User Name</th>
                    <th class="center"> Role</th>
                    <th class="center"> Request Time</th>
                    <th class="center">Approved By/ Time</th>
                    <th class="center">Reset</th>
                </tr>
            </thead>
            <tbody id="tbody">
                @if (ViewBag.count > 0)
                {
                    foreach (var item in Model.ilForgotPasswordViewModel)
                    {
                        <tr>
                            <td>
                                @{ sno++; }
                                @sno
                            </td>

                            <td>
                                @item.UserName
                            </td>
                            <td>@item.RoleName</td>
                            <td>@item.createTime</td>
                            <td>@item.ApprovedDate</td>
                            <td>
                                @if (item.ApprovedDate == null)
                                {
                                <a class="btn btn-link" href="@Url.Action("Reset", "Account", new { id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.ChildId.ToString()), fid = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.id.ToString()) })">
                                    Reset Password
                                </a>
                                }

                            </td>
                        </tr>
                    }
                }
                else
                {
                    
                }
            </tbody>
        </table>
    </div>
</div>


<script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />








