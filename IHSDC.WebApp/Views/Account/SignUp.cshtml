    <style>
        .modal-dialog-fullscreen {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            max-width: none;
        }

        .modal-content-fullscreen {
            height: 100%;
            border-radius: 0;
        }

        .modal-body-fullscreen {
            overflow-y: auto;
        }

        .info-container {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .info-message {
            display: none;
            position: absolute;
            top: 25px;
            left: 50%;
