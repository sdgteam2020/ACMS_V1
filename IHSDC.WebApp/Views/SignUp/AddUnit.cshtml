<div class="card-body custom-card-body">

    @using (Html.BeginForm("AddUnit", "SignUp", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="col">
            @Html.Hidden("id", "model.Unit_ID")

            @Html.Hidden("btnval", myValue)

            <input id="Command" name="Command" class="d-none" value="0" />

            <div class="row custom-row-margin">
                <div class="col-md-12">
                    <label><b>Branch Name</b></label><span class="custom-required-text">*</span>
                    @Html.TextBoxFor(m => m.UnitName, new { @class = "form-control", @maxlength = "50", @autocomplete = "off" })


                </div>
            </div>

            <div class="row custom-row-margin">
                <div class="col-md-12">
                    <label><b>Comd/PSOs Name</b></label><span class="custom-required-text">*</span>
                    @Html.DropDownListFor(m => m.ComdIdUnit, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @class = "select form-control ComdIdUnit" })
                </div>
            </div>

            <div class="row custom-row-margin">
                <div class="col-md-12">
                    <label><b>DGs Name</b></label><span class="custom-required-text">*</span>
                    @Html.TextBoxFor(m => m.CorpId, new { @class = "form-control d-none", @maxlength = "50", @autocomplete = "off" })
                    <select id="spnCorpUnit" class="form-control d-flex"></select>
                </div>

                <div class="col-md-12 text-right">
                    <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success custom-btn-margin js-add-appt">@ViewBag.ButtonName</button>
                </div>
            </div>
        </div>
        <div class="dropdown-divider"></div>
        <div class="table-responsive custom-table-responsive">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Branch Name</th>
                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>


                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILUnitCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.UnitName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Corps)</td>
                                <td>@Html.DisplayFor(modelItem => item.Command)</td>



                            </tr>
                        }
                    }
                    else
                    {

                    }
                </tbody>
            </table>
        </div>
    }
</div>





