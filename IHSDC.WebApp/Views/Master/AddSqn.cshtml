
@model IHSDC.WebApp.Models.SqnCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
   
    ViewBag.Title = "Add SQN ";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}
<link href="@Url.Content("~/DeveloperCSS/AddSQN.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
@{
    string myValue = @ViewBag.ButtonName;
}
@using (Html.BeginForm("AddSqn", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    <div class="card-body squadron-card-body">
        <h3 class="squadron-title">
            Squadron
        </h3>

        <div class="row">
            @Html.Hidden("id", "model.SqnId")
            @Html.Hidden("btnval", myValue)

            <span id="corpsidbind" class="d-none">@ViewBag.corpsId</span>
            <span id="BdeCatIdbind" class="d-none">@ViewBag.BdeCatId</span>

            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "danger" })

            <div class="col squadron-command-col">
                <label><b>Command</b></label>
                @Html.DropDownListFor(
                    m => m.ComdId,
                    (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(),
                    "--Select Comd --",
                    new
                         {
                        @data_show_subtext = "true",
                        @class = "select form-control",
                        @required = "required",
                        @data_live_search = "true",
                        @maxlength = "20"
                    })
                @Html.ValidationMessageFor(model => model.ComdId, "", new { @class = "danger" })
            </div>

            <div class="col">
                <label><b>Corps</b></label>
                <select name="CorpsId" id="CorpsId"
                        class="select form-control" required></select>
            </div>

            <div class="col">
                <label><b>Bde/CATS</b></label>
                <select name="BdeCatId" id="BdeCatId"
                        class="select form-control" required></select>
            </div>

            <div class="col">
                <label><b>SQN Name:</b></label>
                @Html.TextBoxFor(m => m.SqnName,
                    new
                         {
                        @class = "form-control",
                        @maxlength = "40",
                        @required = "required",
                        @autocomplete = "off"
                    })
                @Html.ValidationMessageFor(model => model.SqnName, "", new { @class = "danger" })
            </div>

            <div class="col squadron-button-col">
                <button type="button"
                        value="@ViewBag.ButtonName"
                        data-url="/Master/AddSqn"
                        data-action="AddSqn"
                        name="btnval"
                        class="btn btn-success squadron-add-button">
                    @ViewBag.ButtonName
                </button>
            </div>
        </div>

        <div class="dropdown-divider"></div>

        <div class="table-responsive squadron-table-container">
            <table class="table table-striped"
                   id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">SQN Name</th>
                        <th class="center">Command Name</th>
                        <th class="center">Corps Name</th>
                        <th class="center">Bde/CATS Name</th>
                        <th class="center">Edit</th>
                        <th class="center">Order</th>
                        <th class="center">Shorting</th>
                    </tr>
                </thead>

                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILSqnCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.SqnName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.BdeCatName)</td>
                                <td>
                                    <a href="@Url.Action("AddSqn", "Master", new {
                                    id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.SqnId.ToString())
                                })">
                                        <img src="~/Content/images/Editnew.png"
                                             class="squadron-edit-icon"
                                             alt="Edit Squadron">
                                    </a>
                                </td>
                                <td><span>@item.Orderby</span></td>
                                <td>
                                    @if (sno != 1)
                                    {
                                        <div class="spnOrderbyId d-none">@item.Orderby</div>
                                        <i class="fas fa-2x fa-arrow-circle-up OrderbyId squadron-order-icon"></i>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="squadron-no-record">
                                No Record Found!!!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="@Url.Content("~/scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>


<script src="@Url.Content("~/Content/CustomJS/DeleteConfirmation.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />

<script src="@Url.Content("~/Scripts/jquery.validate.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/CustomJS/Filter.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/DevelopersJs/AddSqn.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
