
@model IHSDC.WebApp.Models.BdeCatCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;


    ViewBag.Title = "Add Bde";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

@{
    string myValue = @ViewBag.ButtonName;
}
<style>

    .custom-bde-card {
        box-shadow: -1px 2px 16px 3px;
    }


    .custom-bde-heading {
        text-align: center;
        box-shadow: 0px 1px 1px;
    }


    .custom-bde-row {
        margin-top: -1rem;
    }


    .custom-btn-margin {
        margin-top: 2.5rem;
    }


    .custom-bde-table {
        margin-left: 1rem;
        padding-right: 2rem;
    }


    .custom-order-arrow {
        color: #f00a0a;
    }


    .custom-no-record {
        font-weight: 600;
        color: red;
        text-align: center;
    }
    .error-label {
        color: red;
    }
</style>

@using (Html.BeginForm("AddBdeCat", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="card-body custom-bde-card">

        <h3 class="custom-bde-heading">
            Brigade
        </h3>

        <div class="row custom-bde-row">

            <div class="col-md-3">
                @Html.Hidden("id", "model.BdeCatId")
                @Html.Hidden("btnval", myValue)

                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "danger" })

                <div class="col">
                    <label><b>Command</b></label>

                    @Html.DropDownListFor(
                        m => m.ComdId,
                        (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(),
                        "--Select Comd --",
                        new
                             {
                            @data_show_subtext = "true",
                            @class = "select form-control",
                            @data_live_search = "true",
                            @required = "required",
                            @maxlength = "20"
                        })

                    @Html.ValidationMessageFor(model => model.ComdId, "", new { @class = "danger" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="col">
                    <label><b>Corps</b></label>
                    <select name="CorpsId" id="CorpsId" class="select form-control" required></select>
                </div>
            </div>

            @Html.Hidden("id", "model.BdeCatId")
            @Html.Hidden("btnval", myValue)

            <div class="col-md-3">
                <div class="col">
                    <label><b>Bde Name :</b></label>

                    @Html.TextBoxFor(
                        m => m.BdeCatName,
                        new
                        {
                            @class = "form-control",
                            @maxlength = "40",
                            @required = "required",
                            @autocomplete = "off"
                        })

                    @Html.ValidationMessageFor(model => model.BdeCatName, "", new { @class = "danger" })
                </div>
            </div>

            <div class="col-md-3">
                <button type="button"
                        value="@ViewBag.ButtonName"
                        name="btnval"
                        class="btn btn-success custom-btn-margin js-add-bdecat">
                    @ViewBag.ButtonName
                </button>
            </div>

        </div>

        <div class="dropdown-divider"></div>

        <span id="corpsidbind" class="d-none">@ViewBag.corpsId</span>

        <div class="table-responsive custom-bde-table">

            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Bde Name</th>
                        <th class="center">Corps Name</th>
                        <th class="center">Command Name</th>
                        <th class="center">Edit</th>
                        <th class="center">Order</th>
                        <th class="center">Shorting</th>
                    </tr>
                </thead>

                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILBdeCatCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>

                                <td>@Html.DisplayFor(modelItem => item.BdeCatName)</td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>

                                <td>
                                    <a href="@Url.Action("AddBdeCat", "Master", new {
                                        id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.BdeCatId.ToString())
                                    })">
                                        <img src="~/Content/images/Editnew.png"
                                             width="30" height="30" border="0" alt="Edit" />
                                    </a>
                                </td>

                                <td>
                                    <span>@item.Orderby</span>
                                </td>

                                <td>
                                    @if (sno != 1)
                                    {
                                        <div class="spnOrderbyId d-none">@item.Orderby</div>
                                        <i class="fas fa-2x fa-arrow-circle-up OrderbyId custom-order-arrow"></i>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="custom-no-record">
                                No Record Found!!!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="~/scripts/jquery-3.3.1.js"></script>


<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />

<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/CustomJS/Filter.js"></script>
<script type="text/javascript">
            var messaget = '@ViewBag.ButtonName';


    $(".OrderbyId").off("click").click(function () {
        var orderby = $(this).closest("td").find(".spnOrderbyId").html();
        updateorder(orderby);

    });
    function updateorder(orderby) {

        $.ajax({
            url: '/Master/bdeOrderby',
            type: 'POST',
            data: { "OrderbyId": orderby },
            success: function (result) {


                if (result == 0) {

                    swal("Successfully!", "Update Order Successfully", "success");
                    location.reload();

                }

            }
        });



    }
    $(document).on("click", ".js-add-bdecat", function (event) {
        AddConfirmation(this, '/Master/AddBdeCat', 'AddBdeCat');
    });
    function AddConfirmation(obj, ActionName, Submit) {
        event.preventDefault();


        $('.error-label').remove();


        var emptyFields = [];
        $('form').find(':input[required]').each(function () {
            if ($.trim($(this).val()) === '') {
                emptyFields.push(this);
            }
        });


        if (emptyFields.length > 0) {
            var firstEmptyField = emptyFields[0];
            $(firstEmptyField).after('<label class="error-label">This field is required</label>');
            return;
        }


        if (messaget == "Add") {
            swal({
                title: "Please Confirm",
                text: "",
                type: "warning",

                showCancelButton: true,
                cancelButtonText: "Cancel",
                cancelButtonColor: "#FF0000",
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Add",

                closeOnCancel: true,
                closeOnConfirm: false
            },
                function (isConfirm) {
                    if (isConfirm) {
                        $('form').submit();
                    }
                });
        } else {
            swal({
                title: "Please Confirm",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Update",
                cancelButtonText: "Cancel",

                closeOnConfirm: false,
                closeOnCancel: true
            },
                function (isConfirm) {
                    if (isConfirm) {
                        $('form').submit();
                    }
                });
        }
    }

   var message = '@message';
    var messageStatus = '@messageStatus';
    var messagemidStatus = '@messagemidStatus ';
    if (message)
        sweetAlert(message, messagemidStatus, messageStatus);
</script>
