            color: black;
            padding: 5px;
            border-radius: 5px;
            width: 420px;
            text-align: left;
            z-index: 1;
        }

            .info-message::after {
                content: "";
                position: absolute;
                top: -5px;
                left: 50%;
                transform: translateX(-50%);
                border-width: 5px;
                border-style: solid;
                border-color: transparent transparent silver transparent;
            }


        .info-container-role {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .info-message-role {
            display: none;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            background-color: #FCFFC3;
            color: black;
            padding: 5px;
            border-radius: 5px;
            width: 420px;
            text-align: left;
            z-index: 1;
        }

            .info-message-role::after {
                content: "";
                position: absolute;
                top: -5px;
                left: 50%;
