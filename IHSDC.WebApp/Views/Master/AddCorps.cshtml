
@model IHSDC.WebApp.Models.CorpsCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
    ViewBag.Title = "Add Corps ";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

@{
    string myValue = @ViewBag.ButtonName;

    int corpsId = ViewBag.CorpsId != null
         ? Convert.ToInt32(ViewBag.CorpsId)
         : 0;
}

@using (Html.BeginForm("AddCorps", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    <div class="card-body custom-card-shadow">

        <h3 class="custom-heading">
            DGs
        </h3>

        @Html.Hidden("Corpsd", corpsId)
        @Html.Hidden("id", Request.QueryString["id"])

        @Html.Hidden("btnval", myValue)
        <div class="row">
            <div class="col-md-3">

                <div class="col">
                    <label><b>Comd/PSOs Name</b></label>
                    @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select Comd --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = "required", @maxlength = "20" })
                    @Html.ValidationMessageFor(model => model.ComdId, "", new { @class = "danger" })
                </div>
            </div>

            <div class="col-md-3">
                <div class="col">
                    <label><b>DGs Name</b></label>
                    @Html.TextBoxFor(m => m.CorpsName, new { @class = "form-control", @maxlength = "25", @autocomplete = "off", @required = "required" })

                    @Html.ValidationMessageFor(model => model.CorpsName, "", new { @class = "danger" })
                </div>
            </div>

            <div class="col-sm-6">
                <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddCorpsConfirm custom-button-top">@ViewBag.ButtonName</button>

            </div>

        </div>
        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-spacing">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>
                        <th class="center">Edit</th>

                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILCorpsCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>
                                <td>
                                    <a href="@Url.Action("AddCorps", "Master", new {   id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.CorpsId.ToString()) })">
                                        <img src="~/Content/images/Editnew.png" width="30" height="30" border="0">
                                    </a>
                                </td>


                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="no-record-found">No Record Found!!!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<link href="~/DeveloperCSS/Master.css" rel="stylesheet" />
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/lib/jquery/jquery.min.js"></script>
<script src="~/DevelopersJs/EncryptePayload.js"></script>
<script src="~/DevelopersJs/AddCorps.js"></script>
<script>
     var message = '@message';
  var messageStatus = '@messageStatus';
  var messagemidStatus = '@messagemidStatus ';
  if (message)
      sweetAlert(message, messagemidStatus, messageStatus);
</script>


