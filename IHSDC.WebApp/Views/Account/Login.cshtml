@using IHSDC.WebApp.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = null;
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

}
<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>ACMS - Login</title>
    <!-- Bootstrap core CSS-->
    <script src="@Url.Content("~/NewContent/vendor/jquery/jquery.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    @*<script src="@Url.Content("~/Content/CustomJS/AviatorJS.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>*@
    <link href="@Url.Content("~/Content/css/dashboard.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet">

    <link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
    <link href="@Url.Content("~/NewContent/vendor/bootstrap/css/bootstrap.min.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <link href="@Url.Content("~/NewContent/vendor/bootstrap/css/bootstrap.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <link href="@Url.Content("~/NewContent/vendor/fontawesome-free/css/all.min.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" type="text/css" media="only screen">
    <link href="@Url.Content("~/NewContent/css/sb-admin.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <link href="@Url.Content("~/DeveloperCSS/Login.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
</head>
<header class="masthead">

    <nav class="navbar navbar-expand-sm bg-dark custom-login-navbar">

        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="~/Content/images/armylogo.png"
                     class="custom-army-logo"
                     alt="Army Logo" />
            </a>
        </div>

        <div class="container-fluid">
            <img src="~/Content/images/acc.png"
                 class="custom-acc-logo"
                 alt="ACC Logo" />
        </div>

    </nav>
    <div class="login-page">

        <div class="login-container">

            <!-- Left Panel -->
            <div class="login-left">

                <div class="login-brand">

                    <h2>Welcome Back</h2>

                    <p>Secure Application Portal</p>

                </div>

                <img src="@Url.Content("~/Images/meet.png")"
                     alt="ACMS Login"
                     class="login-illustration" />

                <div class="login-security">

                    <i class="fa fa-lock"></i>
                    Secure and authorized access

                </div>

            </div>

            <!-- Right Panel -->
            <div class="login-right">

                <div class="login-heading">

                    <h2>Sign in</h2>

                    <p>Enter your credentials to continue.</p>

                </div>

                @using (Html.BeginForm(
                    "Login",
                    "Account",
                    new { ReturnUrl = ViewBag.ReturnUrl },
                    FormMethod.Post,
                    new { id = "loginForm", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "text-danger login-error" })

                    <!-- Username -->
                    <div class="login-form-group">

                        @Html.LabelFor(m => m.Username)

                        <div class="login-input-wrapper">

                            <i class="fa fa-user login-input-icon"></i>

                            @Html.TextBoxFor(
                                m => m.Username,
                                new
                                {
                                    @class = "form-control login-input restrict-copy-paste",
                                    @placeholder = "Enter username",
                                    @maxlength = "30",
                                    @minlength = "3",
                                    @autocomplete = "off"
                                })

                        </div>

                        @Html.ValidationMessageFor(
                            m => m.Username,
                            "",
                            new { @class = "text-danger login-validation" })

                    </div>

                    <!-- Password -->
                    <div class="login-form-group">

                        <label for="pass">Password</label>

                        <div class="login-input-wrapper">

                            <i class="fa fa-lock login-input-icon"></i>

                            @Html.PasswordFor(
                                m => m.Password,
                                new
                                {
                                    @class = "form-control login-input password-input restrict-copy-paste",
                                    @id = "pass",
                                    @placeholder = "Enter password",
                                    @maxlength = "64",
                                    @minlength = "8",
                                    @autocomplete = "off"
                                })

                            <button type="button"
                                    id="togglePassword"
                                    class="password-toggle"
                                    aria-label="Show password"
                                    aria-pressed="false">

                                <i class="fa fa-eye"
                                   id="passwordIcon"></i>

                            </button>

                        </div>

                        @Html.ValidationMessageFor(
                            m => m.Password,
                            "",
                            new { @class = "text-danger login-validation" })

                    </div>

                    <!-- Remember Me -->
                    <div class="login-options">

                        <label class="remember-me">

                            @Html.CheckBoxFor(m => m.RememberMe)

                            <span>Remember me</span>

                        </label>

                    </div>

                    <!-- Sign In Button -->
                    <button type="submit"
                            class="login-button">

                        Sign in

                    </button>

                    <!-- Security Information -->
                    <div class="login-footer">

                        Authorized users only

                    </div>
                }

            </div>

        </div>

    </div>
    <footer class="custom-login-footer">

        <div class="container-fluid">

            <div class="text-center">

                <p class="custom-login-footer-text">

                    Copyright &copy; 2023. Developed by

                    <span class="footer-developer">
                        ASDC, DGIS
                    </span>

                </p>

            </div>

        </div>

    </footer>

</header>
@Html.Partial("_ValidationScriptsPartial")

@*<script src="@Url.Content("~/NewContent/vendor/jquery/jquery.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>*@
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>


<script src="@Url.Content("~/DevelopersJs/Login.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
