<head>
    <link href="~/NewContent/css/sb-admin.css" rel="stylesheet">
</head>


<div class="container">


    @using (Html.BeginForm("AddAgenda", "ACC", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <span id="spnScheduleId" class="agenda-inline-style-01">@Model.Schedule_ID</span>
        <span id="spnNode" class="agenda-inline-style-01">@Model.NodalViewId</span>
        <span id="spnsponsor" class="agenda-inline-style-01">@Model.sponsorId</span>
        <span id="spnUnFreeze" class="agenda-inline-style-01">@Model.AllowEdit</span>
        <span id="spnGSOId" class="agenda-inline-style-01">@Model.ScheduleCreatedById</span>
        <span id="SpnUploadFile" class="agenda-inline-style-01">@ViewBag.UploadPath</span>
        <span id="SpnWordFilePath" class="agenda-inline-style-01">   @ViewBag.WordFilePath</span>
        <span id="spnThumbprint" class="agenda-inline-style-01"></span>
        <span id="spnInboxId" class="agenda-inline-style-01">@Model.Inbox_ID</span>
        <span id="spnArmyNumber" class="agenda-inline-style-01">@SessionManager.ArmyNo</span>
        <span id="spnDefaultPolicy" class="agenda-inline-style-01"></span>
        <span id="spnConfTypeId" class="agenda-inline-style-01"></span>

        @Html.HiddenFor(m => m.Inbox_ID)
        @Html.HiddenFor(m => m.FinalSubmitYN)
        @Html.HiddenFor(m => m.FromInbox)
        if (Convert.ToInt32(SessionManager.UserId) != Model.ScheduleCreatedById)
        {
            @Html.HiddenFor(m => m.IsVisibleToAll)
            @Html.HiddenFor(m => m.AllowEdit)
        }


        if (Convert.ToInt32(SessionManager.UserId) == Model.NodalViewId)
        {
            @Html.HiddenFor(m => m.Title)
            @Html.HiddenFor(m => m.Summary)
            @Html.HiddenFor(m => m.Schedule_ID)
        }


        <div class="card-body agenda-inline-style-02">
            <div class="col">

                <div class="row mb">
                    <div class="col-md-4">
                        <a class="agenda-inline-style-03 btn btn-success agenda-navigate" id="btnNew" data-agenda-url="@Url.Action("AddAgenda", "ACC", new { id = string.Empty,Edit= IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption("1") })">

                            <div class="addagenda">&nbsp; Add New</div>
                        </a>
                    </div>
                    <div class="col-md-4 headingtext">Add / View Agenda Pt</div>
                    <div class="col-md-4"></div>

                </div>
            </div>

            @if (Model.IsEdit == "1")
            {
                <div class="col-lg-12 grid-margin stretch-card">
                    <div class="card1">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12 col-lg-12 col-xl-6 d-flex">
                                    <div class="card radius-10 w-100">
                                        <div class="card-body">
                                            <div class="uploadheadpdf">
                                                Upload Agenda Pt Docu with in 5MB (Pdf & Word Format)
                                            </div>

                                            <div class="upload-btn-wrapper agenda-inline-style-04">
                                                @if (Model.IsView == false)
                                                {

                                                    <button class="btnUpload">Upload pdf file</button>
                                                    @Html.TextBoxFor(m => m.Upload, new { type = "file", id = "files", accept = ".pdf", @class = "agenda-validate-pdf" })

                                                }
                                                else
                                                {

                                                    <button class="btnUpload">Upload pdf file</button>
                                                    @Html.TextBoxFor(m => m.Upload, new { type = "file", id = "files", accept = ".pdf", @disabled = "disabled", @class = "agenda-validate-pdf" })

                                                }
                                            </div>

                                            @if (ViewBag.UploadPath != "")
                                            {


                                                <div class="pdfdownload agenda-inline-style-05">
                                                    <a href="@Url.Action("DownloadAgendaWithWatermark", "ACC", new { title = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(Model.Title.ToString()),path = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(ViewBag.UploadPath.ToString()),ConfId = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(Model.ConfId.ToString()) })">
                                                        Download
                                                    </a>
                                                </div>


                                                <div><button type="button" id="btnSignAgendapoint" class="agenda-inline-style-06">Sign pdf</button></div>
                                            }
                                            @Html.TextBoxFor(m => m.UploadPath, new { @class = "form-control agenda-inline-style-01 agenda-validate-input agenda-only-alphanumeric", @readonly = true, @required = true })
                                            @Html.TextBoxFor(m => m.FileName, new { @class = "form-control agenda-inline-style-01 agenda-validate-input agenda-only-alphanumeric", @readonly = true, @required = true })
                                            @Html.TextBoxFor(m => m.WordFile, new { @class = "form-control agenda-inline-style-01 agenda-validate-input agenda-only-alphanumeric", @readonly = true, @required = true })
                                            <span id="PdfFileError" class="text-danger agenda-inline-style-07">Please Upload a PDF file.</span>

                                            <div class="upload-btn-wrapper agenda-inline-style-08">
                                                @if (Model.IsView == false)
                                                {
                                                    <button class="btnUpload">Upload Word file</button>
                                                    @Html.TextBoxFor(m => m.WordFile, new { type = "file", id = "Wordfiles", accept = ".Docx", @class = "agenda-validate-word" })

                                                }
                                                else
                                                {
                                                    <button class="btnUpload">Upload Word file</button>
                                                    @Html.TextBoxFor(m => m.WordFile, new { type = "file", id = "Wordfiles", accept = ".Docx", @disabled = "disabled", @class = "agenda-validate-word" })

                                                }

                                            </div>
                                            @if (ViewBag.WordFilePath != "")
                                            {


                                                <div class="worddownload agenda-inline-style-09"><a href="@ViewBag.WordFilePath" target="_blank" download="@Model.AmendWordFileName">Download</a></div>


                                            }
                                            @Html.TextBoxFor(m => m.WordFilePath, new { @class = "form-control agenda-inline-style-01 agenda-validate-input agenda-only-alphanumeric", @readonly = true, @required = true })
                                            <span id="wordFileError" class="text-danger agenda-inline-style-07">Please Upload a Word file.</span>


                                            <div id="pdf-container" class="agenda-inline-style-10"></div>

                                        </div>


                                    </div>
                                </div>


                                <div class="col-12 col-lg-12 col-xl-6 d-flex">
                                    <div class="card radius-10 w-100">
                                        <div class="card-body">
                                            <div class="agendahead">
                                                Add Details of Agenda Pt
                                            </div>
                                            @if (SessionManager.IsPermission == 1 || SessionManager.IsPermission == 3 || SessionManager.IsPermission == 5)
                                            {
                                                <div class="rcorners">

                                                    @if (Model.IsView == false)
                                                    {

                                                        <div class="row row-cols-2">
                                                            <div class="col">
                                                                <p class="mb-0 font-weight-bold">Conf&nbsp;<span class="agenda-inline-style-11">*</span></p>

                                                                @if (Convert.ToInt32(SessionManager.UserId) == Model.NodalViewId)
                                                                {
                                                                    if (Model.Inbox_ID != 0)
                                                                    {
                                                                        @Html.DropDownListFor(m => m.Schedule_ID, (new IHSDC.WebApp.Models.MasterModels()).LoadSchedule(0), "--Select Conf --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true, @disabled = "disabled" })
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DropDownListFor(m => m.Schedule_ID, (new IHSDC.WebApp.Models.MasterModels()).LoadSchedule(1), "--Select Conf --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true, @disabled = "disabled" })
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    if (Model.Inbox_ID != 0)
                                                                    {
                                                                        @Html.DropDownListFor(m => m.Schedule_ID, (new IHSDC.WebApp.Models.MasterModels()).LoadSchedule(0), "--Select Conf --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true, @disabled = "disabled" })
                                                                        @Html.HiddenFor(m => m.Schedule_ID)
                                                                    }
                                                                    else
                                                                    {
                                                                        @Html.DropDownListFor(m => m.Schedule_ID, (new IHSDC.WebApp.Models.MasterModels()).LoadSchedule(1), "--Select Conf --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true })
                                                                    }
                                                                }

                                                            </div>

                                                        </div>
                                                        <div class="row row-cols-1 font-weight-bold">
                                                            <div class="col">
                                                                <p class="mb-0">Title(<span id="characterCount">500</span>&nbsp;Characters)&nbsp;<span class="agenda-inline-style-11">*</span></p>
                                                                @if (Convert.ToInt32(SessionManager.UserId) == Model.NodalViewId)
                                                                {

                                                                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control agenda-count-title agenda-only-alphanumeric", @maxlength = "500", @required = true, @disabled = "disabled" })

                                                                }
                                                                else
                                                                {
                                                                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control agenda-count-title", @maxlength = "500", @required = true })


                                                                }
                                                                <div class="PolicyModelOpen">
                                                                    <a href="#" id="btnPopup" class="agenda-inline-style-12">
                                                                        <div class="buttons">
                                                                            <img src="~/Images/search_blue.png" class="agenda-inline-style-13" />
                                                                        </div>
                                                                    </a>
                                                                </div>
                                                                <div id="suggestionBox"></div>

                                                            </div>
                                                        </div>
                                                        <div class="row row-cols-2 font-weight-bold">
                                                            <div class="col">
                                                                <p class="mb-0">Nodal Branch</p>
                                                                @Html.TextBoxFor(m => m.Branch, new { @class = "form-control d-none", @required = true })
                                                                <select id="spnBranch" class="form-control" }></select>
                                                            </div>

                                                            <div class="col font-weight-bold">
                                                                <p class="mb-0">Sponsor&nbsp;<span class="agenda-inline-style-11">*</span></p>

                                                                @Html.TextBoxFor(m => m.UnitName, new { @class = "form-control agenda-validate-input agenda-only-alphanumeric", @readonly = true, @required = true })
                                                            </div>
                                                        </div>

                                                        <div class="row row-cols-2 font-weight-bold">
                                                            <div class="col">
                                                                <p class="mb-0">Summary(<span id="characterCountsum">1000</span>&nbsp;Characters)</p>
