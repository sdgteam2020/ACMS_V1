@model IHSDC.WebApp.Models.CounterLog
@{
    ViewBag.Title = "Counter Logs";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

<link href="@Url.Content("~/DeveloperCSS/CounterLogs.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />

<div class="card-body lowzoom-card" id="lowzoom">
    <div class="row">
        <div class="col">
            <h3 class="custom-text-center">
                Counter Logs
                <a class="btn btn-info float-right" href="@Url.Action("Index","Home")" target="_top">
                    Back
                </a>
            </h3>

        </div>
    </div>
    @using (Html.BeginForm("CounterLog", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="rcorners custom-hidden">
            <div class="row">
                <div class="col-2">
                    <p class="mb-0">From Date</p>

                </div>

                <div class="col-2">
                    <p class="mb-0">To Date</p>

                </div>

            </div>
        </div>
        <span id="spnAviator"></span>



        <div class="row">
            <div class="table-responsive custom-table-spacing">
                <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-info text-white">
                        <tr>
                            <th class="center">Ser No</th>
                            <th class="center">Comd Name</th>
                            <th class="center">Today</th>
                            <th class="center">Current Month</th>
                            <th class="center">Total</th>
                            <th class="center custom-hidden">ComdName</th>
                            <th class="center">Counter Log</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        @if (ViewBag.count > 0)
                        {

                            foreach (var item in Model.ICounterLog)
                            {
                                <tr>
                                    <td>
                                        @{ sno++; }
                                        @sno
                                    </td>

                                    <td>@Html.DisplayFor(modelItem => item.ComdName)</td>

                                    <td>@Html.DisplayFor(modelItem => item.Today)</td>

                                    <td>@Html.DisplayFor(modelItem => item.CurrentMonth)</td>

                                    <td>@Html.DisplayFor(modelItem => item.Total)</td>

                                    <td class="center custom-hidden"><spam class="Aviator_ID">@Html.DisplayFor(modelItem => item.ComdName)</spam></td>

                                    <td>
                                        <button type="button" data-toggle="modal" data-target="#CounterLog" id="BtnUserLog" class="btn btn-success BtnUserLog">
                                            <i class='far fa-user-circle'></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {

                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
</div>


<script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/CustomJS/AddUpdateCounterLog.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<link href="@Url.Content("~/NewContent/SearchDate/dataTables.dataTables.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<script src="@Url.Content("~/NewContent/SearchDate/jquery-3.7.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/NewContent/SearchDate/moment.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>


<div class="modal fade" id="CounterLog">
    <div class="modal-dialog custom-modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-center">

                <button type="button" class="btn btn-danger CloseLogpoup ml-auto" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body custom-modal-body" id="UserLogPrint">
                <h3 class="custom-text-center">Counter Log</h3>

                <div class="table-responsive">
                    <table class="table table-striped" id="aviatorTable" width="100%" cellspacing="0">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>


<script src="@Url.Content("~/DeveloperCSS/CounterLogs.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>





