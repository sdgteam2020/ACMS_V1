
@model IHSDC.WebApp.Models.ComdCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
 

    ViewBag.Title = "Add Comd ";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}


@{
    string myValue = @ViewBag.ButtonName;
}


@using (Html.BeginForm("AddComd", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    <div class="card-body custom-card-shadow">
        <h3 class="custom-heading">
            Comd
        </h3>
        <div class="row">


            @Html.Hidden("id", "model.ComdId")

            @Html.Hidden("btnval", myValue)
            <div class="col-md-3">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "danger" })
                <div class="col">
                    <label><b> Comd/PSOs  Name:</b></label>
                    @Html.TextBoxFor(m => m.ComdName, new { @class = "form-control", @maxlength = "25", @onkeyup = "ValInData(this)", @required = "required" })

                    @Html.ValidationMessageFor(model => model.ComdName, "", new { @class = "danger" })

                </div>
            </div>


            <div class="col-sm-6 custom-left-margin">
                <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddComdConfirm custom-button-top">@ViewBag.ButtonName</button>
            </div>
        </div>
        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-spacing">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Comd/PSOs  Name</th>
                        <th class="center">Edit</th>
                        <th class="center">Order</th>
                        <th class="center">Shorting</th>
                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILComdCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>
                                <td>
                                    <a href="@Url.Action("AddComd", "Master", new {   id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.ComdId.ToString()) })">
                                        <img src="~/Content/images/Editnew.png" width="30" height="30" border="0">
                                    </a>
                                </td>

                                <td><span>@item.Orderby</span></td>
                                <td>
                                    @if (sno != 1)
                                    {
                                        <div class="spnOrderbyId d-none">@item.Orderby</div>
                                        <i class="fas fa-2x fa-arrow-circle-up OrderbyId custom-icon-red"></i>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="no-record-found">No Record Found!!!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="~/scripts/jquery-3.3.1.js"></script>


<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />

<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/Scripts/bootstrap-multiselect.js"></script>
<link href="~/Content/css/bootstrap-multiselect.css" rel="stylesheet" />
<link href="~/DeveloperCSS/Master.css" rel="stylesheet" />
<script src="~/DevelopersJs/AddComd.js"></script>
<script>
     var message = '@message';
  var messageStatus = '@messageStatus';
  var messagemidStatus = '@messagemidStatus ';
  if (message)
      sweetAlert(message, messagemidStatus, messageStatus);
</script>

