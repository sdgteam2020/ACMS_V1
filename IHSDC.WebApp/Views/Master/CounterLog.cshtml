
@model IHSDC.WebApp.Models.CounterLog

@{
    ViewBag.Title = "Counter Logs";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml";
    int sno = 0;
}

<link href="@Url.Content("~/DeveloperCSS/CounterLogs.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"
      rel="stylesheet" />

<div class="card-body lowzoom-card" id="lowzoom">

    <div class="row">
        <div class="col">
            <h3 class="custom-text-center">
                Counter Logs

                <a class="btn btn-info float-right"
                   href="@Url.Action("Index", "Home")"
                   target="_top">
                    Back
                </a>
            </h3>
        </div>
    </div>

    @using (Html.BeginForm("CounterLog", "Master", FormMethod.Post))
    {
        <div class="row">
            <div class="table-responsive custom-table-spacing">

                <table class="table table-striped"
                       id="dataTable"
                       width="100%"
                       cellspacing="0">

                    <thead class="bg-info text-white">
                        <tr>
                            <th>Ser No</th>
                            <th>Comd Name</th>
                            <th>Today</th>
                            <th>Current Month</th>
                            <th>Total</th>
                            <th class="custom-hidden">ComdName</th>
                            <th>Counter Log</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (ViewBag.count > 0 && Model.ICounterLog != null)
                        {
                            foreach (var item in Model.ICounterLog)
                            {
                                <tr>
                                    <td>
                                        @{ sno++; }
                                        @sno
                                    </td>

                                    <td>@Html.DisplayFor(m => item.ComdName)</td>

                                    <td>@Html.DisplayFor(m => item.Today)</td>

                                    <td>@Html.DisplayFor(m => item.CurrentMonth)</td>

                                    <td>@Html.DisplayFor(m => item.Total)</td>

                                    <td class="custom-hidden">
                                        <span class="Aviator_ID">
                                            @item.ComdName
                                        </span>
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-success BtnUserLog"
                                                aria-label="View counter log">
                                            <i class="far fa-user-circle"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>


<!-- Counter Log Custom Modal -->

<div id="CounterLog"
     class="counter-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="counterLogTitle"
     aria-hidden="true">

    <div class="counter-modal-dialog">

        <div class="counter-modal-content">

            <div class="counter-modal-header">

                <button type="button"
                        class="btn btn-danger CloseLogpoup"
                        aria-label="Close">
                    &times;
                </button>

            </div>

            <div class="counter-modal-body" id="UserLogPrint">

                <h3 class="custom-text-center" id="counterLogTitle">
                    Counter Log
                </h3>

                <div id="aviatorTableContainer"
                     class="table-responsive">
                </div>

            </div>

            <div class="counter-modal-footer">

                <button type="button"
                        class="btn btn-primary"
                        id="btnPrintLog">
                    Print
                </button>

                <button type="button"
                        class="btn btn-danger CloseLogpoup">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>


<!-- JavaScript files -->

<script src="@Url.Content("~/DevelopersJs/CounterLog.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
