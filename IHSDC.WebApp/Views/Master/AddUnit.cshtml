
@model IHSDC.WebApp.Models.UnitCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
    ViewBag.Title = "Add Branch";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}
@{
    string myValue = @ViewBag.ButtonName;
    int unitId = ViewBag.Unit_ID != null
     ? Convert.ToInt32(ViewBag.Unit_ID)
     : 0;
}
@using (Html.BeginForm("AddUnit", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    <div class="card-body custom-card-shadow">

        <h3 class="custom-heading">
            Branch
        </h3>
        <div class="row">
            @Html.Hidden("UnitId", unitId)
            @Html.Hidden("id", "model.Unit_ID")

            @Html.Hidden("btnval", myValue)
            <span id="corpsidbind" class="d-none">@ViewBag.corpsId</span>
            <span id="BdeCatIdbind" class="d-none">@ViewBag.BdeCatId</span>
            <span id="SqnIdbind" class="d-none">@ViewBag.SqnIdbind</span>

            <input id="Command" name="Command" class="d-none" value="0" />
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "danger" })
            <div class="col custom-col-margin-left">
                <label><b>Branch Name</b></label>
                @Html.TextBoxFor(m => m.UnitName, new { @class = "form-control", @maxlength = "50", @required = "required", @onkeyup = "ValInData(this)" })

                @Html.ValidationMessageFor(model => model.UnitName, "", new { @class = "danger" })
            </div>
            <div class="col custom-col-margin-left">
                <label><b>Comd/PSOs Name</b></label>
                @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select Comd/PSOs --", new { @data_show_subtext = "true", @class = "select form-control", @required = "required", @data_live_search = "true", @maxlength = "20" })
                @Html.ValidationMessageFor(model => model.ComdId, "", new { @class = "danger" })
            </div>
            <div class="col custom-col-margin-left">
                <label><b>DGs Name</b></label>

                @Html.TextBoxFor(m => m.CorpsId, new { @class = "form-control d-none", @required = true })
                <select name="Corps" id="spnCorpsId" class="select form-control" required>
                    <option value=0>-Select DGs-</option>
                </select>
            </div>


            <div class="col custom-col-margin-left">
                <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddUnitConfirm custom-button-top1">@ViewBag.ButtonName</button>
            </div>
        </div>
        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-spacing">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Branch Name</th>

                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>

                        <th class="center">Edit</th>

                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILUnitCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.UnitName)</td>

                                <td>@Html.DisplayFor(modelItem => item.Corps)</td>
                                <td>@Html.DisplayFor(modelItem => item.Command)</td>

                                <td>
                                    <a href="@Url.Action("AddUnit", "Master", new {   id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.Unit_ID.ToString()) })">
                                        <img src="~/Content/images/Editnew.png" width="20" height="20" border="0">
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="no-record-found">No Record Found!!!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<link href="~/DeveloperCSS/Master.css" rel="stylesheet" />
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/Content/CustomJS/Filter1.js"></script>
<script src="~/DevelopersJs/EncryptePayload.js"></script>
<script src="~/DevelopersJs/AddUnit.js"></script>
<script>
     var message = '@message';
  var messageStatus = '@messageStatus';
  var messagemidStatus = '@messagemidStatus ';
  if (message)
      sweetAlert(message, messagemidStatus, messageStatus);
</script>

