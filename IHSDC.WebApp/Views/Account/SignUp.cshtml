@model IHSDC.WebApp.Models.RegisterViewModel
@{
    ViewBag.Title = "SignUp";
    Layout = null;
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
}
<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>ACMS - SignUp</title>

    <script src="@Url.Content("~/NewContent/vendor/jquery/jquery.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <script src="@Url.Content("~/Content/CustomJS/AviatorJS.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <link href="@Url.Content("~/Content/css/dashboard.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet">

    <script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <script src="@Url.Content("~/NewContent/vendor/jquery/jquery.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
    <link href="@Url.Content("~/NewContent/vendor/bootstrap/css/bootstrap.min.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <link href="@Url.Content("~/NewContent/vendor/bootstrap/css/bootstrap.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <link href="@Url.Content("~/NewContent/vendor/fontawesome-free/css/all.min.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" type="text/css" media="only screen">
    <link href="@Url.Content("~/NewContent/css/sb-admin.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" media="only screen">
    <script src="@Url.Content("~/Content/CustomJS/SignUpfmReg.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <script src="@Url.Content("~/NewContent/dataTable4/js/select2.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <link href="@Url.Content("~/NewContent/dataTable4/css/select2.min.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <link href="@Url.Content("~/DeveloperCSS/SignUp.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />








</head>
<header class="masthead">

    <nav class="navbar navbar-expand-sm bg-dark signup-style-01">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img class="signup-style-02" src="~/Content/images/armylogo.png" />
            </a>

        </div>
        <div class="container-fluid">
            <img class="signup-style-03" src="~/Content/images/acc.png" />
        </div>
    </nav>
    <div class="card-body signup-style-04">
        <div class="card-body">
            <div class="card-body signup-style-05">
                <div class="row">
                    <div class="col-md-4"></div>
                    <div class="col-md-4 headingtext">CREATE NEW USER</div>
                    <div class="col-md-4"></div>

                </div>
                <hr />
                @using (Html.BeginForm("Add", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @Html.HiddenFor(m => m.Active)
                    @Html.HiddenFor(m => m.Password)
                    @Html.HiddenFor(m => m.ConfirmPassword)
                    @Html.HiddenFor(m => m.Username)
                    @Html.AntiForgeryToken()
                    <form>
                        <div class="container">
                            <div class="form-row row-cols-3">
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.Username)
                                    </label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">

                                        <label class="form-control signup-style-09">@Html.DisplayFor(m => m.Username)</label>
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.Number)
                                    </label><font class="signup-style-08">*</font>

                                    <div class="info-container">
                                        <i class="fa fa-info-circle" aria-hidden="true"></i>
                                        <div class="info-message">
                                            <ul>
                                                <li>Please enter the IC No without any special characters or spaces. An exact match of the entered IC No and the IC No fetched from the IACA token (e-CR) is required for successful Two-Factor Authentication (2FA). E.g., IC75695P</li>
                                                <li>For 2FA, the Hastakshar SEWA needs to be installed locally and should be running in the background of the local PC where ACMS is opened.</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.Number, new { @class = "form-control", @maxlength = "10", @required = true, @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.Rank)
                                    </label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">
                                        @Html.DropDownListFor(m => m.Rank, (new IHSDC.WebApp.Models.MasterModels()).LoadRanks(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                                    </div>
                                </div>
                            </div>
                            <div class="form-row row-cols-3">
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.FullName)
                                    </label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", @required = true, @maxlength = "50", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.Appointment)
                                    </label><font class="signup-style-08">*</font>
                                    <a id="setAppt" href="#" data-url="@Url.Action("AddAppt", "SignUp")" title="Click to Add New Appointment in case your respective Appointment is not already avbl in dropdown list.">

                                        <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                    </a>
                                    <div class="col-md-12">
                                        @Html.DropDownListFor(m => m.Appointment, (new IHSDC.WebApp.Models.MasterModels()).LoadAppointment(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true })
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07"></label>

                                    @Html.LabelFor(m => m.Roles)
                                    <font class="signup-style-08">*</font>
                                    <div class="info-container-role">
                                        <i class="fa fa-info-circle" aria-hidden="true"></i>
                                        <div class="info-message-role">
                                            <ul>
                                                <li>In Case you are Responsible for Coordinate and Conduct of Army Level Conf. Please Select Role ‘GSO1’</li>
                                                <li>In Case you are Responsible to Only Upload Agenda Pt for Army Level Conf. Please Select Role ‘Sponsor’</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        @Html.DropDownList("Roles", (IEnumerable<SelectListItem>)ViewData["Roles"], new { id = "rolesDropdown", @class = "select form-control signup-style-18", @data_show_subtext = "true", @data_live_search = "true", @required = true })
                                    </div>
                                </div>
                            </div>
                            <div class="form-row row-cols-3">
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">Comd/PSOs</label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">
                                        @Html.DropDownListFor(m => m.ComdIdSignUp, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = true })
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">DGs</label><font class="signup-style-08">*</font>
                                    <a id="setComdId" href="#" data-url="@Url.Action("AddCorps", "SignUp")" title="Click to Add New DGs in case your respective DG is not already available in the dropdown list">
                                        <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                    </a>

                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.CorpId, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                                        <select id="spnCorp" class="form-control d-flex"></select>
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">Branch</label><font class="signup-style-08">*</font>


                                    <a id="addbranch" href="#" data-url="/SignUp/AddUnitNew" title="Click to Add New Branch in case your respective Branch is not already avbl in dropdown list.">

                                        <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                    </a>
                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.Unit_ID, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                                        <select id="spnUnit" class="form-control" required></select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row row-cols-3">
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.ASCON)
                                    </label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.ASCON, new { @class = "form-control", @maxlength = "10", @required = true, @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="form-group required signup-style-06">
                                    <label class="signup-style-07">
                                        @Html.LabelFor(m => m.MobNo)
                                    </label><font class="signup-style-08">*</font>
                                    <div class="col-md-12">
                                        @Html.TextBoxFor(m => m.MobNo, new { @class = "form-control", @maxlength = "10", @required = true, @autocomplete = "off" })
                                    </div>
                                </div>
                                <div class="col-md-6 mb-4 d-none">
                                    <label>Bde</label>
                                    @Html.TextBoxFor(m => m.BdeId, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                                    <select id="spnBde" class="form-control" }></select>
                                </div>
                            </div>
                            <hr />

                            <div id="addunitmodel" class="modal fade" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-centered" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header d-flex justify-content-center signup-style-10">
                                            <h5 class="modal-title">Add Branch</h5>
                                            <button type="button" class="btn-close-white signup-style-11" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>

                                        <div class="row">
                                            <div class="col-12">

                                                <div class="col-md-12">
                                                    <label><b>Comd/PSOs Name</b></label><font class="signup-style-08">*</font>
                                                    @Html.DropDownList("ComdIdUnit", (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true" })
                                                </div>
                                                <div class="col-md-12">
                                                    <label><b>DGs Name</b></label><font class="signup-style-08">*</font>

                                                    <input type="text" class="d-none" id="CorpIdNew" />

                                                    <select id="spnCorpUnit" class="form-control d-flex"></select>
                                                </div>
                                                <div class="col-md-12">
                                                    <label><b>Branch Name</b></label><font class="signup-style-08">*</font>

                                                    <input type="text" class="form-control" id="UnitName" maxlength="50" />

                                                </div>
                                                <div class="col-md-12 text-right">
                                                    <button type="button" value="Add" name="btnval" class="btn btn-success signup-style-12">Add</button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-body-list">


                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>

                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div id="addApptModal" class="modal fade" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-fullscreen signup-style-13" role="document">
                                    <div class="modal-content modal-content-fullscreen signup-style-13">
                                        <div class="modal-header d-flex justify-content-center signup-style-10">
                                            <h5 class="modal-title">Add Appointment</h5>
                                            <button type="button" class="btn-close-white signup-style-11" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>

                                        <div class="modal-body modal-body-fullscreen signup-style-14">
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="addDgsModal" class="modal fade" tabindex="-1" role="dialog">
                                <div class="modal-dialog modal-dialog-fullscreen signup-style-13" role="document">
                                    <div class="modal-content modal-content-fullscreen signup-style-13">
                                        <div class="modal-header d-flex justify-content-center signup-style-10">
                                            <h5 class="modal-title">Add DGs</h5>
                                            <button type="button" class="btn-close-white signup-style-11" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>

                                        <div class="modal-body modal-body-fullscreen signup-style-14">
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 d-flex justify-content-center">
                                    <div class="form-group">
                                        <div class="col-md-offset-2 text-center">
                                            <button type="submit" class="btn btn-success">Register</button> &nbsp;

                                            <a class="btn btn-success signup-style-15" id="btnNew">
                                                Cancel
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
    <footer class="sticky-footer signup-style-16">
        <div class="container my-auto">
            <div class="copyright text-center my-auto">


                <p class="mb-0  text-light signup-style-17">Copyright © 2023. Developed by <span class="text-danger text-light">ASDC , DGIS</span> </p>
            </div>
        </div>
    </footer>
</header>

<script src="@Url.Content("~/DevelopersJs/SignUp.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
