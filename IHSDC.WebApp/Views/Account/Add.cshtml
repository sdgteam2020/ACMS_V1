@model IHSDC.WebApp.Models.RegisterViewModel
@{
    /**/
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
    ViewBag.Title = "Add User";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml";
}
<head>
    <link href="@Url.Content("~/DeveloperCSS/Add.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />

</head>


    @using (Html.BeginForm("Add", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
        @Html.AntiForgeryToken()
<div class="card-body custom-card-body">
    <div class="card-body">
        <div class="card-body custom-card-padding">
            <div class="row">
                <div class="col-md-4"></div>
                <div class="col-md-4 headingtext">NEW USER</div>
                <div class="col-md-4"></div>

            </div>
            <hr />


            <div class="container">

                <div class="form-row row-cols-3">
                  
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Username, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control username-input", @required = true, @maxlength = "20", @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Password, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @required = true, @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @required = true, @readonly = "readonly" })
                        </div>
                    </div>
                </div>

                <div class="form-row row-cols-3">
                   
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Rank, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(m => m.Rank, (new IHSDC.WebApp.Models.MasterModels()).LoadRanks(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Number, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.Number, new { @class = "form-control username-input", @maxlength = "10", @required = true, @autocomplete = "off" })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.FullName, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control username-input", @maxlength = "50", @required = true, @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="form-row row-cols-3">
                    <!-- Third Row -->
                    <div class="form-group required custom-form-group">
                        <label class="custom-label">Comd/PSOs</label>
                        <span class="required-star">*</span>
                        <div class="col-md-12">
                            @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        <label class="custom-label">DGs</label>
                        <span class="required-star">*</span>
                       
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.CorpId, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                            <select id="spnCorp" class="form-control"></select>
                        </div>
                    </div>
                    <div class="form-group d-none">
                        <label class="custom-label">Bde</label>
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.BdeId, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                            <select id="spnBde" class="form-control" }></select>
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        <label class="custom-label">Branch</label>
                        <span class="required-star">*</span>
                       
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.Unit_ID, new { @class = "form-control d-none", @required = true, @autocomplete = "off" })
                            <select id="spnUnit" class="form-control" required></select>
                        </div>
                    </div>
                </div>

                <div class="form-row row-cols-3">

                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Appointment, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(m => m.Appointment, (new IHSDC.WebApp.Models.MasterModels()).LoadAppointment(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.Roles, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.DropDownList("Roles",
     (IEnumerable<SelectListItem>)ViewData["Roles"],
     new
     {
         id = "rolesDropdown",
         @class = "roles-dropdown",
         @required = true
     })
                        </div>
                    </div>
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.ASCON, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.ASCON, new { @class = "form-control username-input", @required = true, @maxlength = "10", @autocomplete = "off" })
                        </div>
                    </div>
                </div>

                <div class="form-row row-cols-3">
                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(model => model.Active, htmlAttributes: new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.DropDownListFor(model => model.Active, (new IHSDC.WebApp.Models.MasterModels()).LoadActive(), "--Select --", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                        </div>
                    </div>

                    <div class="form-group required custom-form-group">
                        @Html.LabelFor(m => m.MobNo, new { @class = "col-md-12 control-label" })
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.MobNo, new { @class = "form-control username-input", @autocomplete = "off", @maxlength = "10", @required = true })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                       
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-12 d-flex justify-content-center">
                    <div class="form-group">
                        <div class="col-md-offset-2 text-center">
                         

                            <input type="submit" class="btn btn-primary" value="Add" />

                            <span>
                                @Html.ActionLink("View Users", "Hierarchy", "Account", new object { }, new { @class = "btn btn-primary" })
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
    }
             
                <script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
              
                @section Scripts {
                    @Scripts.Render("~/bundles/jqueryval")
                }

<script src="@Url.Content("~/DevelopersJs/Add.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>