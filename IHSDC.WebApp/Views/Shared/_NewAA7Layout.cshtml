            <!-- Chat dialog -->
            <div id="asdcChat"
                 class="asdc-chat"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="asdcChatTitle"
                 hidden>
                <div class="asdc-chat-header">
                    <div class="asdc-chat-header-left">
                        <img src="~/css/chatbot/favicon.png" alt="ASDC" class="asdc-chat-logo">
                        <div class="asdc-chat-title-wrap">
                            <h3 id="asdcChatTitle" class="asdc-chat-title">DGIS Assistant (ACMS)</h3>
                            <small class="asdc-chat-subtitle">
                                Developed by ASDC, DGIS
                            </small>
                        </div>
                    </div>
                    <div class="asdc-chat-header-actions">
                        <button id="asdcFullscreen" class="asdc-chat-btn" type="button" aria-label="Toggle full screen">⛶</button>
                        <button id="asdcClose" class="asdc-chat-close" type="button" aria-label="Close chat">×</button>
                    </div>
                </div>

                <div id="asdcLoading" class="asdc-loading" hidden>⏳ Generating response...</div>

                <div id="asdcChatBox" class="asdc-chat-box" aria-live="polite" aria-busy="false"></div>

                <div class="asdc-chat-composer">
                    <input id="asdcQuery" type="text" class="asdc-input" placeholder="Type your question…" autocomplete="off">
                    <button id="asdcSend" class="asdc-send" type="button">Send</button>
                </div>
            </div>

