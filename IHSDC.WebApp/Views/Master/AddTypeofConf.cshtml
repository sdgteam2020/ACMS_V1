@model IHSDC.WebApp.Models.TypeofConfCRUD
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

    ViewBag.Title = "Conf Type";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

@{
    string myValue = @ViewBag.ButtonName;
}


@using (Html.BeginForm("AddTypeofConf", "Master", FormMethod.Post, new { enctype = "multipart/form-data", id = "TypeConfForm" }))
{

    <div class="card-body custom-card-shadow">
        <h3 class="custom-heading">
            Conf Type
        </h3>
        <div class="row">
            @Html.Hidden("id", "model.TypeofConfId")


            @Html.Hidden("btnval", myValue)

            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "danger" })

            <div class="col custom-col-left">
                <label><b>Conf Type:</b></label>
                @Html.TextBoxFor(m => m.TypeOfConf, new { @class = "form-control", @maxlength = "100", @autocomplete = "off", @required = "required" })

                @Html.ValidationMessageFor(model => model.TypeOfConf, "", new { @class = "danger" })

            </div>
            <div class="col custom-col-left">
                <label><b>Default Policy:</b></label>
                @Html.DropDownListFor(m => m.PolicyId, (new IHSDC.WebApp.Models.MasterModels()).LoadResPolicy(), "--Select Policy --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @required = "required", @maxlength = "20" })
            </div>


            @if (myValue == "Update")
            {
                <div class="col-md-6">
                    <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success updateTypeConf custom-button-top1">@ViewBag.ButtonName</button>
                </div>
            }
            else
            {
                <div class="col-md-6">
                    <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddConfirmation custom-button-top1">@ViewBag.ButtonName</button>
                </div>
            }

        </div>
        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-spacing">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Conf Type</th>
                        <th class="center">Default Policy</th>
                        <th class="center">Edit</th>
                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILTypeofConfCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.TypeOfConf)</td>
                                <td>@Html.DisplayFor(modelItem => item.PolicyName)</td>
                                <td>
                                    <a href="@Url.Action("AddTypeOfConf", "Master", new {   id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.TypeOfConfId.ToString()) })">
                                        <img src="~/Content/images/Editnew.png" width="30" height="30" border="0">
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="no-record-found">No Record Found!!!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<link href="~/DeveloperCSS/Master.css" rel="stylesheet" />
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/lib/jquery/jquery.min.js"></script>
<script src="~/DevelopersJs/EncryptePayload.js"></script>
<script src="~/DevelopersJs/AddTypeOfConf.js"></script>
<script>
     var message = '@message';
  var messageStatus = '@messageStatus';
  var messagemidStatus = '@messagemidStatus ';
  if (message)
      sweetAlert(message, messagemidStatus, messageStatus);
</script>

