@model IHSDC.WebApp.Models.CorpsCRUD
@{
    ViewBag.Title = "Add Corps ";
    Layout = null;
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

    int sno = 0;
}
<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>ACMS - SignUp</title>
    <style>
        .error-label {
            color: red;
        }

        .custom-btn-margin {
            margin-top: 2.5rem;
        }

        .custom-card-body {
            padding: 0.3rem;
            border: 0px solid #89CFF0;
            width: 600px;
        }

        .custom-row-margin {
            margin-left: 1rem;
        }

        .custom-required-text {
            color: red;
            font-weight: bold;
            font-size: 20px;
        }

        .custom-table-responsive {
            margin-left: 1rem;
            padding-right: 2rem;
        }
    </style>
    <script src="~/NewContent/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/CustomJS/AviatorJS.js"></script>
    <link href="~/Content/css/dashboard.css" rel="stylesheet">
    <link href="~/NewContent/vendor/bootstrap/css/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/NewContent/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/NewContent/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <link href="~/NewContent/vendor/datatables/dataTables.bootstrap4.css" rel="stylesheet">

    <link href="~/NewContent/css/sb-admin.css" rel="stylesheet">

    <link href="~/NewContent/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/NewContent/css/Sidebar.css" rel="stylesheet">

    <link rel="icon" href="~/Images/dgis_ico.png" type="image/x-icon">


    <link rel="stylesheet" href="~/NewContent/dataTable4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/NewContent/dataTable4/css/buttons.bootstrap4.min.css">
    <link rel="stylesheet" href="~/NewContent/dataTable4/css/responsive.bootstrap4.min.css">
    <link href="~/NewContent/dataTable4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/NewContent/dataTable4/css/searchBuilder.dataTables.min.css" rel="stylesheet" />
    <link href="~/NewContent/dataTable4/css/dataTables.dateTime.min.css" rel="stylesheet" />
    <link href="~/NewContent/dataTable4/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="~/NewContent/dataTable4/css/colReorder.dataTables.min.css" rel="stylesheet" />

    <link href="~/NewContent/vendor/bootstrap/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/NewContent/vendor/bootstrap/css/fonts/icomoon/style.css" rel="stylesheet" />
    <link href="~/NewContent/dataTable4/css/select2.min.css" rel="stylesheet" />


</head>
<div class="card-body custom-card-body">
    @using (Html.BeginForm("AddCorps", "SignUp", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="col">
         <div class="row custom-row-margin">
             <div class="col-md-12">
                 <label><b>Comd/PSOs Name</b></label><span class="custom-required-text">*</span>
                 @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select Comd --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @maxlength = "20" })

             </div>
         </div>

         <div class="row custom-row-margin">
             <div class="col-md-12">
                 <label><b>DGs Name</b></label><span class="custom-required-text">*</span>
                 @Html.TextBoxFor(m => m.CorpsName, new { @class = "form-control", @maxlength = "25", @autocomplete = "off" })



             </div>
             <div class="col-md-12 text-right">
                 <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success custom-btn-margin js-add-corps">@ViewBag.ButtonName</button>

             </div>
         </div>

        </div>

        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-responsive">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>


                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILCorpsCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>

                            </tr>
                        }
                    }
                    else
                    {

                    }
                </tbody>
            </table>
        </div>
    }
</div>


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('.dropdownsearch').select2();
    });

        var messaget = '@ViewBag.ButtonName';


    $(".OrderbyId").off("click").click(function () {
        var orderby = $(this).closest("td").find(".spnOrderbyId").html();
        updateorder(orderby);
      
    });
    function updateorder(orderby) {

        $.ajax({
            url: '/Master/CorpsOrderby',
            type: 'POST',
            data: { "OrderbyId": orderby }, //get the search string
            success: function (result) {


                if (result== 0) {

                    swal("Successfully!", "Update Order Successfully", "success");
                    location.reload();

                }

            }
        });



    }

   
    function AddConfirmationDgs(obj, ActionName, Submit) {
        event.preventDefault();

      
        $('.error-label').remove();

        
        var emptyFields = [];
        $('form').find(':input[required]').each(function () {
            if ($.trim($(this).val()) === '') {
                emptyFields.push(this);
            }
        });

    
        if (emptyFields.length > 0) {
            var firstEmptyField = emptyFields[0];
            $(firstEmptyField).after('<label class="error-label">This field is required</label>');
            return;
        }

      
        if (messaget == "Add") {
            swal({
                title: "Please Confirm",
                text: "",
                type: "warning",

                showCancelButton: true,
                cancelButtonText: "Cancel",
                cancelButtonColor: "#FF0000",
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Add",

                closeOnCancel: true,
                closeOnConfirm: false
            },
                function (isConfirm) {
                    if (isConfirm) {
                        $('form').submit();
                    }
                });
        } else {
            swal({
                title: "Please Confirm",
                text: "",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#DD6B55",
                confirmButtonText: "Yes, Update",
                cancelButtonText: "Cancel",

                closeOnConfirm: false,
                closeOnCancel: true
            },
                function (isConfirm) {
                    if (isConfirm) {
                        $('form').submit();
                    }
                });
        }
    }

      var message = '@message';
    var messageStatus = '@messageStatus';
    var messagemidStatus = '@messagemidStatus ';
    if (message)
        sweetAlert(message, messagemidStatus, messageStatus);
</script>
