@model IHSDC.WebApp.Models.RankCRUD
@{  
    var message = TempData["Message"] != null
        ? TempData["Message"].ToString()
        : string.Empty;

    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

    ViewBag.Title = "Add Rank ";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

@{
    string myValue = @ViewBag.ButtonName;
   
}

@Html.Partial("~/Views/Shared/_ValidationScriptsPartial.cshtml")
@using (Html.BeginForm("AddRank", "Master", FormMethod.Post, new { id = "rankForm", enctype = "multipart/form-data" }))
{

    <div class="card-body custom-card-shadow">
        <h3 class="custom-heading">
            Rank
        </h3>
        <div class="row">
            @Html.Hidden("id", "model.RankId")

            @Html.Hidden("btnval", myValue)
            <input type="hidden"
                   id="mes"
                   name="mes"
                   value="@message" />
         
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="col custom-col-left">
                <label><b>Rank Abbreviation:</b></label>
                @Html.TextBoxFor(m => m.RankName, new { @class = "form-control", @autocomplete = "off", @maxlength = "150", @required = "required" })

                @Html.ValidationMessageFor(model => model.RankName, "", new { @class = "text-danger" })
                <span id="RankNameValidation"
                      class="text-danger d-none"
                      role="alert">
                </span>
            </div>


            <div class="col">

                <label><b>Rank Name:</b></label>
                @Html.TextBoxFor(m => m.RankAbbreviation, new { @class = "form-control", @required = "required", @maxlength = "150", @autocomplete = "off" })

                @Html.ValidationMessageFor(model => model.RankAbbreviation, "", new { @class = "text-danger" })
            </div>


            <div class="col-md-6">
                <button type="submit" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddRankConfirm custom-button-top1">@ViewBag.ButtonName</button>
            </div>
        </div>
        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-spacing">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Rank Abbreviation</th>
                        <th class="center">Rank Name</th>
                        <th class="center">Edit</th>

                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILRankCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.RankName)</td>
                                <td>@Html.DisplayFor(modelItem => item.RankAbbreviation)</td>
                                <td>
                                    <a href="@Url.Action("AddRank", "Master", new {   id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.RankId.ToString()) })">
                                        <img src="~/Content/images/Editnew.png" width="30" height="30" border="0">
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="no-record-found">No Record Found!!!</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/CustomJS/DeleteConfirmation.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<link href="@Url.Content("~/DeveloperCSS/Master.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<script src="@Url.Content("~/DevelopersJs/AddRank.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>




