@using Microsoft.AspNet.Identity
@using IHSDC.WebApp.Helper
@using IHSDC.WebApp.Connection

@model IHSDC.WebApp.Models.EditUserViewModel


@{
    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
    ViewBag.Title = "Edit User";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; }
<head>
    <link href="@Url.Content("~/DeveloperCSS/EditUser.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />

</head>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
   
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <div class="col-md-12">
            @Html.HiddenFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control disabled" } })
        </div>
    </div>
    <div class="card-body custom-card-body">
        <div class="card-body">
            <div class="card-body custom-card-padding">
                <div class="row">
                    <div class="col-md-4"></div>
                    <div class="col-md-4 headingtext">UPDATE : @ViewBag.EditUsername</div>
                    <div class="col-md-4"></div>
                    <span id="spnUserTypeId" class="hidden-user-type">@ViewData["UserTypeId"]</span>
                    <span id="UnitId" class="hidden-user-type">@ViewData["UnitId"]</span>
                </div>
                <hr />
                @if (SessionManager.RoleId == enum1.Administrator)
                {

                    <div class="container">

                        <div class="form-row row-cols-3">
                            <!-- First Row -->
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Username, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control username-input", @maxlength = "20", @autocomplete = "off" })
                                </div>
                            </div>
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Roles, new { @class = "col-md-12 control-label Roles" })
                                <div class="col-md-12">
                                    @Html.DropDownListFor(m => m.Roles, (IEnumerable<SelectListItem>)ViewData["Roles"], new { @class = "Roles role-dropdown" })
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(model => model.Active, htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12">
                                    @Html.DropDownListFor(model => model.Active, (new IHSDC.WebApp.Models.MasterModels()).LoadActive(), "--Select --", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                                </div>
                            </div>
                        </div>

                      
                        <div class="form-row row-cols-3">
                            <!-- Second Row -->
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Number, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.Number, new { @class = "form-control username-input", @maxlength = "10", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Rank, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.DropDownListFor(m => m.Rank, (new IHSDC.WebApp.Models.MasterModels()).LoadRanks(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })

                                </div>
                            </div>
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.FullName, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control username-input", @maxlength = "50", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Password, new { @class = "col-md-12 control-label d-none" })
                                <div class="col-md-12">
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control d-none", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>

                        <div class="form-row row-cols-3">
                            <!-- Third Row -->
                            <div class="form-group required custom-form-group">
                                <label class="custom-label">Comd/PSOs</label>
                                <span class="required-star">*</span>
                                <a href='@Url.Action("AddComd", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">
                                    @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                                </div>

                            </div>

                            <div class="form-group required custom-form-group">
                                <label class="custom-label">DGs</label>
                                <span class="required-star">*</span>
                             
                                <a href='@Url.Action("AddCorps", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.CorpId, new { @class = "form-control d-none", @autocomplete = "off", @required = true })
                                    <select id="spnCorp" class="form-control"></select>
                                </div>
                            </div>

                            <div class="form-group required custom-form-group d-none">
                                <label class="custom-label d-none">Bde</label>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.BdeId, new { @class = "form-control d-none", @autocomplete = "off", @required = true })
                                    <select id="spnBde" class="form-control"></select>
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">

                                <label class="custom-label">Branch</label><span class="required-star">*</span>
                                <a href='@Url.Action("AddUnit", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.Unit_ID, new { @class = "form-control d-none", @autocomplete = "off", @required = true })
                                    <select id="spnUnit" class="form-control" required></select>
                                </div>
                            </div>
                        </div>

                        <div class="form-row row-cols-3">

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Appointment, new { @class = "col-md-12 control-label" })
                                <a href='@Url.Action("AddAppt", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">

                                    @Html.DropDownListFor(m => m.Appointment, (new IHSDC.WebApp.Models.MasterModels()).LoadAppointment(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })

                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.ASCON, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.ASCON, new { @class = "form-control username-input", @autocomplete = "off", @maxlength = "10"})
                                </div>
                            </div>
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.MobNo, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.MobNo, new { @class = "form-control username-input", @autocomplete = "off", @maxlength = "10", @required = true })

                                </div>
                            </div>
                        </div>
                    </div>

                }

                @if (SessionManager.RoleId == enum1.GSO1 || SessionManager.RoleId == enum1.Sponsor || SessionManager.RoleId == enum1.Nodal)
                {

                    <div class="container">

                        <div class="form-row row-cols-3">
                            <!-- First Row -->
                           <div class="form-group required custom-form-group">
                               @Html.LabelFor(m => m.Username, new { @class = "col-md-12 control-label" })
                               <div class="col-md-12">
                                   @Html.TextBoxFor(m => m.Username, new { @class = "form-control username-input", @maxlength = "20", @autocomplete = "off", @readonly = "readonly" })
                               </div>
                           </div>
                           <div class="form-group required custom-form-group">
                               @Html.LabelFor(m => m.Roles, new { @class = "col-md-12 control-label Roles" })
                               <div class="col-md-12">
                                   @Html.DropDownListFor(m => m.Roles, (IEnumerable<SelectListItem>)ViewData["Roles"], new { @class = "Roles role-dropdown" })
                               </div>
                           </div>

                           <div class="form-group required custom-form-group">
                               @Html.LabelFor(model => model.Active, htmlAttributes: new { @class = "control-label col-md-12" })
                               <div class="col-md-12">
                                   @Html.DropDownListFor(model => model.Active, (new IHSDC.WebApp.Models.MasterModels()).LoadActive(), "--Select --", new {  @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                               </div>
                           </div>
                        </div>


                        <div class="form-row row-cols-3">
                            <!-- Second Row -->
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Number, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.Number, new { @class = "form-control username-input", @maxlength = "10", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Rank, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.DropDownListFor(m => m.Rank, (new IHSDC.WebApp.Models.MasterModels()).LoadRanks(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })

                                </div>
                            </div>
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.FullName, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control username-input", @maxlength = "20", @autocomplete = "off" })
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.Password, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="form-row row-cols-3">
                            <!-- Third Row -->
                            <div class="form-group required custom-form-group">
                                <label class="custom-label">Comd/PSOs</label><span class="required-star">*</span>

                                <div class="col-md-12">
                                    @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })
                                </div>

                            </div>

                            <div class="form-group required custom-form-group">
                                <label class="custom-label">DGs</label><span class="required-star">*</span>
                                <a href='@Url.Action("AddCorps", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.CorpId, new { @class = "form-control d-none", @autocomplete = "off", @maxlength = "10", @required = true })
                                    <select id="spnCorp" class="form-control"></select>
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                <label class="custom-label">Bde</label>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.BdeId, new { @class = "form-control d-none", @autocomplete = "off", @maxlength = "10", @required = true })
                                    <select id="spnBde" class="form-control"></select>
                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                <label class="custom-label">Branch</label><span class="required-star">*</span>
                                <a href='@Url.Action("AddUnit", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.Unit_ID, new { @class = "form-control d-none", @autocomplete = "off", @maxlength = "10", @required = true })
                                    <select id="spnUnit" class="form-control" required></select>
                                </div>
                            </div>
                        </div>

                        <div class="form-row row-cols-3">

                            <div class="form-group required custom-form-group">
                                <label class="custom-label">Appt</label><span class="required-star">*</span>
                                <a href='@Url.Action("AddAppt", "Master")' )>
                                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                                </a>
                                <div class="col-md-12">

                                    @Html.DropDownListFor(m => m.Appointment, (new IHSDC.WebApp.Models.MasterModels()).LoadAppointment(), "--Select--", new { @data_show_subtext = "true", @class = "select form-control", @data_live_search = "true", @required = true })

                                </div>
                            </div>

                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.ASCON, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                    @Html.TextBoxFor(m => m.ASCON, new { @class = "form-control username-input", @autocomplete = "off", @maxlength = "10", @required = true })
                                </div>
                            </div>
                            <div class="form-group required custom-form-group">
                                @Html.LabelFor(m => m.MobNo, new { @class = "col-md-12 control-label" })
                                <div class="col-md-12">
                                
                                    @Html.TextBoxFor(m => m.MobNo, new { @class = "form-control username-input", @autocomplete = "off", @maxlength = "10", @required = true })

                                </div>
                            </div>
                        </div>
                    </div>

                }


                <hr />
                <div class="row">
                    <div class="col-12 d-flex justify-content-center">
                        <div class="form-group">
                            <div class="col-md-offset-2 text-center">
                                <input type="submit" value="Save" class="btn btn-primary" />
                                @if (SessionManager.RoleId == enum1.Administrator)
                                {
                                    <span>
                                       <a class="btn btn-primary custom-margin-left" href="/Account/Hierarchy">Back to List</a>
                                    </span>
                                }
                               
                            </div>
                        </div>
                    </div>
                </div>






            </div>
        </div>
    </div>


}

<script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/CustomJS/SignUp.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="@Url.Content("~/DevelopersJs/EditUser.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>