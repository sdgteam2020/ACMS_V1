@model IHSDC.WebApp.Models.InboxCRUD
@using IHSDC.WebApp.Connection
@using Microsoft.AspNet.Identity
@using IHSDC.WebApp.Helper
@using System.Data

@{ ViewBag.Title = "Appx A Report";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; }

<head>
    <link href="@Url.Content("~/DeveloperCSS/AppxAReport.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
</head>

<body>

    <div class="row">
        <div class="col">
         
            <a href="#" class="btn btn-info float-right mb-1 btnBack">Back</a>
        </div>
    </div>
    <div class="card card-page">
        <div class="card-body" id="PrintAppxA">
            <header class="custom-restricted-header">
                <span><b><u>RESTRICTED</u></b></span>
            </header>
            <br />
            <br />
            <div class="row custom-row-right">
                <div class="col-12">
                    <b><u>Appx A</u></b>
                    <br />
                    <b>
                        <span>(@ViewBag.RefNo)</span>
                    </b>
                </div>
            </div>
            <div class="row custom-row-center">
                <div class="col-1"></div>
                <div class="col-10">
                    <span class="custom-summary-heading">
                        SUMMARY : STAFF EXAM OF AGENDA PTS
                    </span>
                    <br />
                </div>
                <br />
                <div class="col-1"></div>
            </div>

            <div class="container">

                <div class="row custom-row-margin-top">
                    <div class="col-12 custom-text-black">

                        <table width="100%" class="table table-striped align-top custom-appx-table" id="AppxA">
                            @if (ViewBag.Record != 0)
                            {
                                <thead class="bg-info text-white">
                                    <tr class="custom-tr-center">
                                        @{
                                            int Head = 0;
                                        }
                                        @foreach (var dr in ViewBag.Header.Rows)
                                        {
                                            if (Head == 0)
                                            {
                                                <th class="custom-th-left">
                                                    <span id="spnNodal" class="custom-nodal-text">
                                                        Nodal <i class="fas fa-long-arrow-alt-right"></i>
                                                    </span>
                                                    <br />
                                                    <span id="spnSponsor" class="custom-sponsor-text">
                                                        @dr["NodalName"].ToString()
                                                        <i class="fas fa-long-arrow-alt-down"></i>
                                                    </span>

                                                </th>
                                            }
                                            else
                                            {
                                                <th class="custom-th-left">@dr["NodalName"].ToString()</th>
                                            }
                                            Head = Head + 1;
                                        }
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        for (int i = 0; i < ViewBag.tbl_Data.Rows.Count; i++)
                                        {
                                            <tr class="custom-th-left">
                                                @{
                                                    int rowTotal = 0;
                                                    for (int j = 0; j < ViewBag.tbl_Data.Columns.Count; j++)
                                                    {
                                                        <td>
                                                            @if (j == 0)
                                                            {
                                                                @ViewBag.tbl_Data.Rows[i][j].ToString()
                                                            }
                                                            else
                                                            {
                                                                if (ViewBag.tbl_Data.Rows[i][j].ToString() == "")
                                                                {
                                                                    @: -
                                                                }
                                                                else
                                                                {
                                                                    var cellValue = int.Parse(ViewBag.tbl_Data.Rows[i][j].ToString());
                                                                    rowTotal += cellValue;
                                                                    @cellValue
                                                                }
                                                            }
                                                        </td>
                                                    }
                                                    <td>@rowTotal</td>
                                                }
                                            </tr>
                                        }
                                    }
                                    <tr class="custom-th-left">
                                        @{
                                            var LastTotal = 0;
                                        }
                                        <td>Total</td>
                                        @{
                                            for (int j = 1; j < ViewBag.tbl_Data.Columns.Count; j++)
                                            {
                                                var columnTotal = 0;
                                                for (int i = 0; i < ViewBag.tbl_Data.Rows.Count; i++)
                                                {
                                                    if (ViewBag.tbl_Data.Rows[i][j].ToString() == "")
                                                    {
                                                        columnTotal += int.Parse("0");
                                                        LastTotal += int.Parse("0");
                                                    }
                                                    else
                                                    {
                                                        columnTotal += int.Parse(ViewBag.tbl_Data.Rows[i][j].ToString());
                                                        LastTotal += int.Parse(ViewBag.tbl_Data.Rows[i][j].ToString());
                                                    }

                                                }
                                                <td>@columnTotal</td>
                                            }
                                        }
                                        <td>@LastTotal</td>
                                    </tr>
                                </tbody>
                            }
                        </table>

                    </div>
                </div>
            </div>
            <footer class="custom-tr-center"><span class="custom-tr-center"><b><u>RESTRICTED</u></b></span></footer>
        </div>
    </div>
    <form action="~/Home/Upload" method="post" id="myForm">
        <input type="hidden" name="data1" id="data1">
        <input type="hidden" name="filename" id="filename" value="AppxA">

    </form>

</body>




<script src="@Url.Content("~/Scripts/jquery-3.3.1.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Scripts/pdfmake.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Scripts/html2canvas.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/DevelopersJs/AppxAReport.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>

