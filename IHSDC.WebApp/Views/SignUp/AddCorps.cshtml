<div class="card-body custom-card-body">
    @using (Html.BeginForm("AddCorps", "SignUp", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="col">
         <div class="row custom-row-margin">
             <div class="col-md-12">
                 <label><b>Comd/PSOs Name</b></label><span class="custom-required-text">*</span>
                 @Html.DropDownListFor(m => m.ComdId, (new IHSDC.WebApp.Models.MasterModels()).LoadCommandName(), "--Select Comd --", new { @data_show_subtext = "true", @class = "select form-control dropdownsearch", @data_live_search = "true", @maxlength = "20" })

             </div>
         </div>

         <div class="row custom-row-margin">
             <div class="col-md-12">
                 <label><b>DGs Name</b></label><span class="custom-required-text">*</span>
                 @Html.TextBoxFor(m => m.CorpsName, new { @class = "form-control", @maxlength = "25", @autocomplete = "off" })



             </div>
             <div class="col-md-12 text-right">
                 <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success custom-btn-margin js-add-corps">@ViewBag.ButtonName</button>

             </div>
         </div>

        </div>

        <div class="dropdown-divider"></div>


        <div class="table-responsive custom-table-responsive">
            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">DGs Name</th>
                        <th class="center">Comd/PSOs Name</th>


                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILCorpsCRUD)
                        {
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CorpsName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ComdName)</td>

                            </tr>
                        }
                    }
                    else
                    {

                    }
                </tbody>
            </table>
        </div>
    }
</div>


