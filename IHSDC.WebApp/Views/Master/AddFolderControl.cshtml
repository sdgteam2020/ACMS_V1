@model IHSDC.WebApp.Models.FolderControlPermissionCRUD
@using IHSDC.WebApp.Helper
@using IHSDC.WebApp.Connection
@{

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;

    ViewBag.Title = "Add Folder";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}

@{
    string myValue = @ViewBag.ButtonName;
    int folderControlId = ViewBag.FolderControlId != null
     ? Convert.ToInt32(ViewBag.FolderControlId)
     : 0;
}

<link href="@Url.Content("~/DeveloperCSS/AddFolder.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />

@using (Html.BeginForm("AddFolderControl", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(m => m.FolderControlId)
    @Html.Hidden("FolderControlId", folderControlId)

    @Html.Hidden("id", Request.QueryString["id"])

    @Html.Hidden("btnval", myValue)

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "danger" })

    <div class="card-body custom-card-shadow">

        <h3 class="custom-heading">
            Folder Access Permission
        </h3>
        <div class="container mt-4">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label><b>Name of Folder (Created By/ Name of Br):</b></label>
                    @Html.DropDownListFor(m => m.PolicyId, (new IHSDC.WebApp.Models.MasterModels()).LoadFolders(), "--Select Folder --", new { @data_show_subtext = "true", @class = "form-control select dropdownsearch", @data_live_search = "true", @required = "required", @maxlength = "20" })
                    @Html.ValidationMessageFor(model => model.PolicyId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label><b>Users:</b></label>
                    @Html.TextBoxFor(m => m.Users, new { @class = "hidden-field" ,@autocomplete = "off" })

                    <div id="OrgId">
                        <select id="ddlUsers" multiple="multiple" name="UserPolicies" class="form-control">
                            @if (Model.ILFolderUserCRUD != null)
                            {
                                foreach (var item in Model.ILFolderUserCRUD)
                                {
                                    if (item.UserName != null)
                                    {
                                        if (item.Msg == "Selected")
                                        {
                                            <option value="@item.PUserId" selected="selected">
                                                @item.UserName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@item.PUserId">
                                                @item.UserName
                                            </option>
                                        }
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success saveAddFolderControlConfirm">@ViewBag.ButtonName</button>
                </div>
            </div>
        </div>



        <div class="dropdown-divider"></div>
        <div class="table-responsive custom-table-spacing">

            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Name of Folder (Created By/ Name of Br)</th>
                        <th class="center">Users</th>
                        <th class="center">Edit</th>
                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        foreach (var item in Model.ILFolderControlPermissionCRUD)
                        {
                            <tr>
                                <td class="width-5">

                                    @{ sno++; }
                                    @sno
                                </td>
                                <td class="width-25">
                                    <div class="Refvarter-container">
                                        @Html.DisplayFor(modelItem => item.PolicyName)
                                        <div class="Refvarter">
                                            @Html.DisplayFor(modelItem => item.RefLetter)
                                        </div>
                                    </div>
                                </td>
                                <td class="user-column width-65" title="@item.UsersName">

                                    @Html.DisplayFor(modelItem => item.UsersName)
                                </td>
                                <td class="width-5">
                                    <a href='@Url.Action("AddFolderControl", "Master", new { id = IHSDC.WebApp.RepositryManager.EncryptionManager.Encryption(item.FolderControlId.ToString()) })'>
                                        <img src="~/Content/images/Editnew.png" width="30" height="30" border="0">
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
}


<script src="@Url.Content("~/Scripts/jquery-3.3.1.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/CustomJS/DeleteConfirmation.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Content/css/sweetalert.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<link href="@Url.Content("~/Content/css/sweetalert.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<link href="@Url.Content("~/DeveloperCSS/Master.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
<script src="@Url.Content("~/Scripts/jquery.validate.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
<script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Styles.Render("~/Content/cssjqryUi")


    <head runat="server">
        <script src="@Url.Content("~/Scripts/bootstrap-multiselect.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
        <link href="@Url.Content("~/Content/css/bootstrap-multiselect.css")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion" rel="stylesheet" />
        
    </head>

    <script src="@Url.Content("~/DevelopersJs/EncryptePayload.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    <script src="@Url.Content("~/DevelopersJs/AddFolderControl.js")?v=@IHSDC.WebApp.Helper.GlobalVersion.JSVersion"></script>
    

}