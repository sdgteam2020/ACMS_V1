            function PrintDiv() {
                let popupWin = window.open('', '_blank', 'top=100,width=900,height=500,location=no');
                popupWin.document.open();

                let tableStyles = `
                                                            <style type="text/css">
                                                                table {
                                                                    width: 100%;
                                                                    border-collapse: collapse;
                                                                    margin-bottom: 20px;
                                                                }
                                                                .custom-watermark {
                                                                     transform: rotate(-45deg);
    z-index: 10000;
    opacity: 0.3;
    color: #8e9191;
    position: fixed;
    left: 6%;
    top: 39%;
    font-size: 80px;
    font-weight: 500;
    display: grid;
