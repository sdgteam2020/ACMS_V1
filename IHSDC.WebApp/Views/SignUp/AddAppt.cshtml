</head>

<div class="card-body custom-card-body">


    @using (Html.BeginForm("AddAppt", "SignUp", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {

        <div class="col">

            @Html.Hidden("id", "model.ApptId")

            @Html.Hidden("btnval", myValue)

            @Html.AntiForgeryToken()

            <div class="row custom-row-margin">
                <div class="col-md-12">
                    <label><b>Appt Abbreviation:</b></label><span class="custom-required-text">*</span>
                    @Html.TextBoxFor(m => m.Appt, new { @class = "form-control", @maxlength = "25", @autocomplete = "off" })


                </div>
            </div>

            <div class="row custom-row-margin">
                <div class="col-md-12">

                    <label><b>Appt Name:</b></label><span class="custom-required-text">*</span>
                    @Html.TextBoxFor(m => m.ApptAbbreviation, new { @class = "form-control", @maxlength = "100", @autocomplete = "off" })


                </div>
                <div class="col-md-12 text-right">

                    <button type="button" value="@ViewBag.ButtonName" name="btnval" class="btn btn-success custom-btn-margin js-add-appt">@ViewBag.ButtonName</button>
                </div>
            </div>

        </div>
        <div class="dropdown-divider"></div>
        <div class="table-responsive custom-table-responsive">

            <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                <thead class="bg-info text-white">
                    <tr>
                        <th class="center">S/No</th>
                        <th class="center">Appt Abbreviation</th>
                        <th class="center">Appt Name</th>


                    </tr>
                </thead>
                <tbody id="tbody">
                    @if (ViewBag.count > 0)
                    {
                        int oldorder = 0;
                        foreach (var item in Model.ILApptCRUD)
                        {
                            if (oldorder == 0)
                            {
                                oldorder = @item.Orderby;
                            }
                            <tr>
                                <td>
                                    @{ sno++; }
                                    @sno
                                </td>

                                <td>@Html.DisplayFor(modelItem => item.Appt)</td>

                                <td>@Html.DisplayFor(modelItem => item.ApptAbbreviation)</td>




                            </tr>
                        }
                    }
                    else
                    {

                    }
                </tbody>
            </table>
        </div>

    }

</div>

