@model IHSDC.WebApp.Models.UserLog
@{
    ViewBag.Title = "UserLog";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml"; int sno = 0;
}


<style id="table_style" type="text/css">
    @@media print {

        @@page {
            size: A3 landscape;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        body::after {
            content: none !important;
        }

        .card-page {
            break-after: page;
        }

            .card-page:last-of-type {
                break-after: auto;
            }

        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 10px;
            background-color: gray;
            color: white;
            text-align: center;
            padding: 10px;
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 10px;
            background-color: gray;
            color: white;
            text-align: center;
            padding: 10px;
        }
    }
</style>
<style>
    .watermark-text {
        transform: rotate(-45deg);
        z-index: 10000;
        opacity: 0.3;
        color: #8e9191;
        position: fixed;
        top: 39%;
        left: 6%;
        font-size: 80px;
        font-weight: 500;
        display: grid;
        justify-content: center;
        align-content: center;
    }
</style>
<div class="card-body custom-card-body" id="lowzoom">
    <div class="row">
        <div class="col">
            <h3 class="heading-center">
                User Log
                <a class="btn btn-info float-right" href="@Url.Action("Index","Home")" target="_top">
                    Back
                </a>
            </h3>

        </div>
    </div>
    @using (Html.BeginForm("UserLog", "Master", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="rcorners">
            <div class="row">
                <div class="col-2">
                    <p class="mb-0">From Date</p>
                    @Html.TextBoxFor(m => m.LogFromDate, new { @class = "form-control datepicker3", @autocomplete = "off", @placeholder = "dd/mm/yyyy", @required = true })
                </div>

                <div class="col-2">
                    <p class="mb-0">To Date</p>
                    @Html.TextBoxFor(m => m.LogToDate, new { @class = "form-control datepicker3", @autocomplete = "off", @placeholder = "dd/mm/yyyy", @required = true })
                </div>
                
            </div>
        </div>
        <span id="spnAviator"></span>



        <div class="row">
            <div class="table-responsive custom-table-spacing">
                <table class="table table-striped" id="dataTable" width="100%" cellspacing="0">
                    <thead class="bg-info text-white">
                        <tr>
                            <th class="center">S/No</th>
                            <th class="center">Unit</th>
                            <th class="center">User Name</th>
                            <th class="center">Full Name</th>
                            <th class="center">Role</th>
                            <th class="center d-none-custom">ID</th>
                            
                            <th class="center d-none-custom">Role</th>
                            <th class="center">User Log</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        @if (ViewBag.count > 0)
                        {
                            foreach (var item in Model.IUserLog)
                            {
                                <tr>
                                    <td>
                                        @{ sno++; }
                                        @sno
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.UnitName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.RoleName)</td>
                                    <td class="center d-none-custom"><spam class="Aviator_ID">@Html.DisplayFor(modelItem => item.IntId)</spam></td>
                                    <td class="center d-none-custom"><spam class="User_Name">@Html.DisplayFor(modelItem => item.UserName)</spam></td>
                                    <td>
                                        <button type="button" data-toggle="modal" data-target="#UserLog" id="BtnUserLog" class="btn btn-success BtnUserLog">
                                            <i class='far fa-user-circle'></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                           
                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
</div>


<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/Content/CustomJS/DeleteConfirmation.js"></script>
<script src="~/Content/CustomJS/AddUpdateFilter.js"></script>
<script src="~/Content/css/sweetalert.min.js"></script>
<link href="~/Content/css/sweetalert.css" rel="stylesheet" />
<link href="~/NewContent/SearchDate/dataTables.dataTables.css" rel="stylesheet" />
<link href="~/DeveloperCSS/Master.css" rel="stylesheet" />
<script src="~/NewContent/SearchDate/jquery-3.7.1.js"></script>
<script src="~/NewContent/SearchDate/moment.min.js"></script>


<div class="modal fade" id="UserLog">
    <div class="modal-dialog custom-modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-center">
                <p class="custom-paragraph">
                    <span>User Name :&nbsp;&nbsp;&nbsp;&nbsp;</span><b><span id="SpnAviatorName"></span></b><br />
                </p>
                <button type="button" class="btn btn-danger CloseLogpoup" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body modal-body-scroll-600" id="UserLogPrint">
                <h3 class="heading-center">User Log</h3>

                <div class="table-responsive">
                    <table class="table table-striped" id="aviatorTable" width="100%" cellspacing="0">
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>




<script type="text/javascript">
        $('.CloseLogpoup').on('click', function (e) {
            var modal = document.getElementById("UserLog");
            modal.style.display = "none";
        });

        $(document).ready(function () {
            $('#dataTable').DataTable({
                paging: true, // Enable pagination
                info: true, // Show table information
                "lengthMenu": [5, 10, 25, 50], // Customize the number of rows per page
                "pageLength": 5 // Set the initial number of rows per page
            });
        });

    function PrintDiv() {
        var divToPrint = document.getElementById('UserLog');
        var popupWin = window.open('', '_blank', 'top=100,width=900,height=500,location=no');
        popupWin.document.open();
        var table_style = document.getElementById("table_style").innerHTML;
        popupWin.document.write('<style type = "text/css">');
        popupWin.document.write(table_style);
        popupWin.document.write('</style>')
        popupWin.document.title = 'MonthWiseUsersLog';
        popupWin.document.write('<html><body onload="window.print()">' + divToPrint.innerHTML + '<div class="watermark-text">' + '@(ViewBag.ipadd)' + "" + '</html>');
        popupWin.document.close();
    }

</script>


