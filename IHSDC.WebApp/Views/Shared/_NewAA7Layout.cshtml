                max-height: 17px;
                max-width: 17px;
                margin-left: 20px;
                margin-right: 20px;
            }

            .navbar {
                padding: 0.1rem 0.1rem
            }

            .imgback {
                margin-left: 5px;
                margin-top: 0px;
                max-height: 25px;
                max-width: 135px;
            }
        }
    </style>
