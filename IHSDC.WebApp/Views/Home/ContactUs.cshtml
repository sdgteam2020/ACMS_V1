@using IHSDC.WebApp.Connection
@model System.Web.Mvc.FormCollection
@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_NewAA7Layout.cshtml";

    var message = TempData["Message"] ?? string.Empty;
    var messageStatus = TempData["messageStatus"] ?? string.Empty;
    var messagemidStatus = TempData["messagemidStatus"] ?? string.Empty;
}


<!DOCTYPE html>
<html>

<head>
    <link href="@Url.Content("~/DeveloperCSS/ContactUs.css")?v=@DateTime.UtcNow.Ticks"
          rel="stylesheet" />
    <script src="@Url.Content("~/DevelopersJs/ContactUs.js")?v=@DateTime.UtcNow.Ticks"></script>
  
</head>

<body>

    <div class="container card border-left-primary shadow py-2 asdc-main-container">

        <div class="row">

            <div class="col-md-12 asdc-text-center">

                <img src="@Url.Content("~/Images/asdc_logo.png")"
                     class="asdc-logo"
                     alt="ASDC Logo" />

                <strong class="asdc-current-time">

                    <span class="asdc-time-value">
                        @ViewBag.CurrentTime.ToString("dd-MM-yyyy HH:mm:ss")
                    </span>

                    Time&nbsp;-&nbsp;&nbsp;&nbsp;&nbsp;

                </strong>

            </div>

        </div>

        <div class="row1">

            <div class="col-md-12">

                <center>

                    <strong class="asdc-welcome-text">

                        <h5 class="asdc-welcome-heading">
                            <u>WELCOMES ALL SUGGESTIONS / FEEDBACK</u>
                        </h5>

                    </strong>

                </center>

            </div>

            <div class="col-md-12">

                <h1 class="asdc-main-heading">
                </h1>

            </div>

            <div class="col-md-12">

                <h1 class="asdc-main-heading">

                    <strong class="asdc-address">

                        Army Software Development Centre(ASDC),
                        DGIS, New Delhi - 110010

                        <br /><br />

                    </strong>

                    <strong>

                        @if (Request.IsAuthenticated &&
                            !string.IsNullOrEmpty(SessionManager.Active?.ToString()) &&
                            SessionManager.Active.ToString() == "0")
                        {
                            <strong class="asdc-registration-message">

                                Dear User you have Successfully Registered.
                                Please Approach for Necessary Approval (39644).

                            </strong>
                        }

                    </strong>

                </h1>

            </div>

        </div>

        <div class="row asdc-contact-row">

           

            <div class="col-md-4">

                <div class="tree-icon">

                    <img src="@Url.Content("~/Images/walk.jpg")"
                         class="asdc-contact-image"
                         aria-hidden="true" />

                </div>

                <div>

                    <h6 class="asdc-eoffice-heading">

                        eOffice Id: g1coord_asdc_ihqa

                    </h6>

                </div>

            </div>


           

            <div class="col-md-4">

                <div class="tree-icon">

                    <img src="@Url.Content("~/Images/calls2__.png")"
                         class="asdc-contact-image-square"
                         aria-hidden="true" />

                </div>

                <div class="asdc-contact-details">

                    <h6 class="asdc-contact-heading">

                        Army : 39644

                    </h6>

                </div>

            </div>


          

            <div class="col-md-4 asdc-contact-last-column">

                <div class="tree-icon">

                    <img src="@Url.Content("~/Images/calls.jpg")"
                         class="asdc-contact-image-round"
                         aria-hidden="true" />

                </div>

                <div class="asdc-contact-details">

                    <h6 class="asdc-contact-heading">

                        Log query/Suggestion

                    </h6>

                    <h6 class="asdc-contact-bold">

                        Recommendation

                    </h6>

                    <h6 class="asdc-contact-bold">

                        <a class="asdc-user-guide-link"
                           target="_blank"
                           rel="noopener noreferrer"
                           href="https://dgis.army.mil/acms.html">

                            User Guide

                        </a>

                    </h6>

                </div>

            </div>

            <br /><br />

        </div>

    </div>

</body>

</html>
