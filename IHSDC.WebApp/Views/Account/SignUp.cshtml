            height: 100%;
            border-radius: 0;
        }

        .modal-body-fullscreen {
            overflow-y: auto;
        }

        .info-container {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .info-message {
            display: none;
            position: absolute;
            top: 25px; /* Positioning the tooltip below the icon */
            left: 50%;
            transform: translateX(-50%);
            background-color: #FCFFC3;
            color: black;
            padding: 5px;
            border-radius: 5px;
            width: 420px;
            text-align: left;
            z-index: 1;
        }

            .info-message::after {
                content: "";
                position: absolute;
                top: -5px; /* Position the arrow above the tooltip */
                left: 50%;
                transform: translateX(-50%);
                border-width: 5px;
                border-style: solid;
                border-color: transparent transparent silver transparent; /* Arrow pointing upwards */
            }


        .info-container-role {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .info-message-role {
            display: none;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            background-color: #FCFFC3;
            color: black;
            padding: 5px;
            border-radius: 5px;
            width: 420px;
            text-align: left;
            z-index: 1;
        }

            .info-message-role::after {
                content: "";
                position: absolute;
                top: -5px; /* Position the arrow above the tooltip */
                left: 50%;
                transform: translateX(-50%);
                border-width: 5px;
                border-style: solid;
                border-color: transparent transparent silver transparent; /* Arrow pointing upwards */
            }
    </style>
    <script>
        function ValInData1(input) {
            var regex = /[^0-9]/g;
            input.value = input.value.replace(regex, "");
        }
        function ValInData(input) {
            var regex = /[^a-zA-Z0-9 ]/g;
            input.value = input.value.replace(regex, "");
        }

        function ValInDataReg(input) {
            var regex = /[^a-zA-Z0-9]/g;
            input.value = input.value.replace(regex, "");
        }
    </script>



    <script type="text/javascript">
        $(document).ready(function () {
            $('#ComdIdSignUp').val("");
        // Password toggle visibility
        $("#chk").click(function () {
            if ($(this).prop("checked")) {
                $("#pass").attr("type", "text");
            } else {
                $("#pass").attr("type", "password");
            }
        });


        // Clear password on document ready
        $("#pass").val("");

        // Handle Username change
        $('#Username').change(function () {
            $("#Password").val('Admin123!');
            $("#ConfirmPassword").val('Admin123!');
        });

        // Handle setComdId and setUnit clicks
        $('#setComdId, #setUnit').on('click', function () {


            $('#CorpId').val(1);
            $('#BdeId').val(1);

          //  BindCorp($("#ComdIdSignUp").val());
            BindBde($("#ComdIdSignUp").val(), $("#CorpId").val());
            BindUnit($("#ComdIdSignUp").val(), $("#CorpId").val(), $("#BdeId").val());
        });

        // Handle ComdIdSignUp, spnCorp, spnBde, and spnUnit changes
        $('#ComdIdSignUp').change(function () {
            $('#CorpId').val(1);
            $('#BdeId').val(1);
            //alert($('#ComdIdSignUp').val());
             var value = $(this).val();
            //   BindCorp($(this).val());
            if (value) {
                BindCorp(value);
            }

            BindBde($(this).val(), $('#CorpId').val());
            BindUnit($(this).val(), $('#CorpId').val(), $('#BdeId').val());
        });


        $('#ComdId').change(function () {
            $('#CorpId').val(1);
            $('#BdeId').val(1);

            BindCorp($(this).val());
            BindBde($(this).val(), $('#CorpId').val());
            BindUnit($(this).val(), $('#CorpId').val(), $('#BdeId').val());
        });




        $('#spnCorpUnit').change(function () {
            $("#CorpIdNew").val($('#spnCorpUnit').val());
            BindBde($("#ComdIdUnit").val(), $("#CorpIdNew").val());
            BindUnitUnit($("#ComdIdUnit").val(), $("#CorpIdNew").val(), $("#BdeId").val());
        });


        $('#spnCorp').change(function () {
            $("#CorpId").val($(this).val());
            BindBde($("#ComdIdSignUp").val(), $(this).val());
            BindUnit($("#ComdIdSignUp").val(), $(this).val(), $("#BdeId").val());
        });

        $('#spnBde').change(function () {
            $("#BdeId").val($(this).val());
            BindUnit($("#ComdIdSignUp").val(), $("#CorpId").val(), $(this).val());
        });

        $('#spnUnit').change(function () {
           // alert('onchange brach fii condition check');
            $("#Unit_ID").val($(this).val());
        });

